  @@index([tenantId, branchId, active])
  @@index([tenantId, patientId, active])
  @@index([tenantId, patientId, coverageOrder, effectiveFrom, effectiveTo], map: "PatientInsurancePolicy_tenantId_patientId_coverageOrder_effecti")
}

