  callLogs      ReceptionistCallLog[] @relation("ReceptionistCallLogTarget")
  lastCallLog   ReceptionistCallLog? @relation("ReceptionistCallTargetLastCall", fields: [tenantId, campaignId, lastCallLogId], references: [tenantId, outboundCampaignId, id], onDelete: Restrict, map: "ReceptionistCallTarget_last_call_ownership_fkey")
  providerIntents ReceptionistOutboundProviderIntent[]

  @@unique([tenantId, campaignId, id])
  @@index([tenantId, campaignId, status])
  @@unique([tenantId, campaignId, phone])
}

