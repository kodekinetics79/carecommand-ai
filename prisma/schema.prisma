model CampaignDelivery {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  campaignId        String    @db.Uuid
  patientId         String?   @db.Uuid
  leadId            String?   @db.Uuid
  channel           String
  destinationMasked String?
  status            String    @default("pending")
  provider          String?
  providerMessageId String?
  idempotencyKey    String?
  failureReason     String?
  // A provider 2xx response is acceptance, not proof of delivery. `sentAt` is
  // retained for backward compatibility; new code records the truthful
  // acceptance/delivery milestones below.
  sentAt            DateTime?
  providerAcceptedAt DateTime?
  deliveredAt       DateTime?
  statusUpdatedAt   DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign          Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  submissionClaims  CampaignSubmissionClaim[]
  attributions      CampaignAttribution[]

  @@unique([campaignId, patientId, leadId, channel])
  // Referenced by CampaignSubmissionClaim so a claim can never be attached to a
  // delivery row belonging to another tenant.
  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, providerMessageId])
}

// ===========================================================================
// Patient Intake + Consent Engine (Phase A). Tenant-scoped, RLS-ready (RLS NOT
// enabled this phase). No PHI in logs; documents are metadata-only unless real
// object storage exists. Public access is via a hashed, expiring, packet-scoped
// token. Reuses Patient/Appointment/Insurance/Payment/Consent foundations.
// ===========================================================================
// ---------------------------------------------------------------------------
// Live campaign dispatch fence (Growth / CRM outreach).
//
// Two tables, one purpose: make the consent decision and the provider hand-off
// inseparable, and keep live regulated outreach OFF until a named human turns it
// on for their own tenant.
// ---------------------------------------------------------------------------

/// Durable, append-only submission evidence for ONE campaign recipient attempt.
/// Ported from the receptionist appointment-confirmation outbox
/// (NotificationDeliveryAttempt phases):
///   PROVIDER_INTENT  - written by campaignDispatch inside the transaction that
///                      holds the same suppression advisory fences opt-out
///                      writers take and that re-reads suppression. This commit
///                      is the linearization point: an opt-out is either visible
///                      to it, or it lands strictly after the authorization.
///   SUBMISSION_CLAIM - appended inside commsProvider immediately BEFORE
///                      provider I/O, exactly once per attempt. The unique index
///                      is what makes a second worker a no-op instead of a
///                      duplicate send.
///   RESULT           - the truthful outcome. `accepted` is provider acceptance,
///                      never delivery.
model CampaignSubmissionClaim {
  id                   String    @id @default(uuid()) @db.Uuid
  tenantId             String    @db.Uuid
  campaignId           String    @db.Uuid
  campaignDeliveryId   String    @db.Uuid
  attemptNumber        Int
  phase                String
  status               String
  channel              String
  /// sha256 of the canonical destination. Evidence without PHI.
  destinationHash      String
  idempotencyKey       String
  /// The exact operator authorization this attempt was submitted under.
  launchFingerprint    String
  consentEvidence      String
  /// mock_dev | live. A live attempt additionally requires dispatchActivationId.
  submissionMode       String
  dispatchActivationId String?   @db.Uuid
  provider             String?
  providerMessageId    String?
  failureCode          String?
  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  tenant               Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaignDelivery     CampaignDelivery @relation(fields: [tenantId, campaignDeliveryId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, campaignDeliveryId, attemptNumber, phase])
  @@index([tenantId, phase, startedAt])
  @@index([tenantId, campaignId, startedAt])
}

/// Per-tenant, per-channel authority to submit LIVE regulated campaign traffic.
///
/// Absence means OFF. There is deliberately no column default, no seed, no
/// migration backfill and no provisioning hook that can create one: a row exists
/// only because an OWNER/ADMIN called the activation endpoint and typed an
/// explicit attestation while the channel provider was actually configured.
/// Deactivation sets revokedAt instead of deleting, so the attestation that was
/// in force for an already-submitted message stays readable.
model CampaignLiveDispatchActivation {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  channel           String
  activatedByUserId String    @db.Uuid
  activatedAt       DateTime  @default(now())
  /// The exact sentence the activating operator typed. Stored verbatim.
  attestation       String
  attestationHash   String
  /// Which fence implementation the attestation was made against.
  fenceVersion      String
  /// Truthful provider state at activation time (env key NAMES only, no secrets).
  providerSnapshot  Json
  revokedAt         DateTime?
  revokedByUserId   String?   @db.Uuid
  revocationReason  String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel])
  @@index([tenantId, revokedAt])
}

// ---------------------------------------------------------------------------
// Closed-loop campaign attribution.
//
// Campaign.opened/responded/booked/revenue existed for months with NO code path
// that wrote them: a campaign could run end to end and the dashboard still
// reported $0, because nothing anywhere joined CampaignDelivery to Appointment
// or to a payment. This table is that join, made durable and arguable.
//
// The competitive point is not having a number. Tebra multiplies volume by
// hardcoded constants ($3 per reminder sent, $150 per recall appointment), so a
// practice that sent 5,000 reminders is shown $15,000 of "ROI" against zero
// production. RevenueWell credits itself with ALL revenue from any appointment
// within 60 days of an unmatched new-patient request, plus flat $5/$10 imputed
// values. Neither survives a practice manager asking "which message earned that
// dollar?". Every row here answers exactly that, or the row does not exist.
// ---------------------------------------------------------------------------

/// Immutable evidence linking ONE CampaignDelivery to ONE outcome. Nothing in
/// the application updates a row after it is written; re-running the
/// attribution job inserts what is missing and touches nothing else.
///
/// THE WINDOW IS CAPTURED ON THE ROW ON PURPOSE. windowDays, windowStartsAt and
/// windowEndsAt record the attribution window that was in force at the moment
/// this link was made, not the window in force now. A later edit to
/// GrowthPolicy.campaignAttributionWindowDays must change what gets attributed
/// NEXT and must never retroactively rewrite, widen, narrow or invalidate an
/// attribution that has already been claimed. Re-deriving the window at read
/// time would do exactly that, and would make every historical number
/// unreproducible the first time a tenant edited a setting.
///
/// attributedValue is money a named PaymentTransaction actually recorded. A
/// booking is not revenue and an attendance is not revenue: both carry 0. There
/// is deliberately no imputed per-event constant anywhere in this table.
model CampaignAttribution {
  id                   String              @id @default(uuid()) @db.Uuid
  tenantId             String              @db.Uuid
  /// The branch the outcome actually happened in. A branch-scoped campaign can
  /// only ever attribute an outcome from its own branch (enforced by the job),
  /// so for those campaigns this equals Campaign.branchId.
  branchId             String?             @db.Uuid
  campaignId           String              @db.Uuid
  campaignDeliveryId   String              @db.Uuid
  patientId            String?             @db.Uuid
  leadId               String?             @db.Uuid
  /// engaged | booked | attended | paid. The vocabulary lives in
  /// server/lib/campaignAttribution.ts (CAMPAIGN_ATTRIBUTION_OUTCOMES); it is
  /// not a database CHECK, for the same reason CampaignSubmissionClaim.phase is
  /// not one. `engaged` is deliberately NEVER written today — see that module's
  /// header for why a provider "open" is not evidence in this system.
  outcomeType          String
  appointmentId        String?             @db.Uuid
  paymentTransactionId String?             @db.Uuid
  attributedValue      Decimal             @default(0) @db.Decimal(12, 2)
  currency             String              @default("USD")
  /// The window that justified THIS link, as it stood when the link was made.
  windowDays           Int
  windowStartsAt       DateTime
  windowEndsAt         DateTime
  /// The named rule that produced the row, so any figure can be argued back to
  /// the sentence that generated it.
  rule                 String
  /// Delivery acceptance timestamp, outcome timestamp, the rule applied, the
  /// tie-break, and the exact record ids the value came from. Ids and
  /// timestamps only — no PHI, no destinations, no message bodies.
  evidence             Json
  attributedAt         DateTime            @default(now())
  createdAt            DateTime            @default(now())
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Every parent link is tenant-composite: an attribution can never point at
  // another tenant's campaign, delivery, patient, appointment or payment, even
  // if an id is guessed. Cascade throughout — an attribution to a record that
  // no longer exists is not evidence, so it must not outlive its subject, and
  // no attribution row may block the deletion of the thing it describes.
  branch               Branch?             @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)
  // Campaign is referenced by id alone, deliberately. A (tenantId, id) unique on
  // Campaign already exists in the deployed database under a migration-owned
  // rls_uq_ name; declaring it in Prisma would turn a managed DROP INDEX into an
  // ALTER INDEX ... RENAME in `prisma migrate diff` and move the pinned counts
  // in server/modules/platform/prismaDriftGuard.ts, which this increment does
  // not own. The guarantee is not lost: CampaignAttribution_tenant_consistency
  // (migration 20260828230000) refuses any row whose campaignId is not a
  // campaign of NEW."tenantId" AND is not the campaign the referenced delivery
  // belongs to — which is strictly stronger than the composite FK would be.
  campaign             Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  delivery             CampaignDelivery    @relation(fields: [tenantId, campaignDeliveryId], references: [tenantId, id], onDelete: Cascade)
  patient              Patient?            @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Cascade)
  lead                 Lead?               @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Cascade)
  appointment          Appointment?        @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade)
  payment              PaymentTransaction? @relation(fields: [tenantId, paymentTransactionId], references: [tenantId, id], onDelete: Cascade)

  /// Idempotence. Re-running the attribution job can only ever be a no-op for a
  /// delivery whose outcome of this type is already recorded.
  @@unique([tenantId, campaignDeliveryId, outcomeType])
  /// The anti-double-count. One appointment is claimed by at most ONE delivery
  /// per outcome type, so two campaigns that both reached the same patient can
  /// never both book the same booking. NULL appointmentIds stay distinct, which
  /// is what lets a future non-appointment outcome coexist here.
  @@unique([tenantId, outcomeType, appointmentId])
  @@index([tenantId, campaignId, outcomeType])
  @@index([tenantId, attributedAt])
  @@index([tenantId, campaignDeliveryId])
}

model PatientIntakePacket {
