  clinic          ReceptionistClinic?   @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  campaign        ReceptionistCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
