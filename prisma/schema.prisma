// ===========================================================================
// AI Receptionist Studio
// Configurable, multi-tenant voice-agent engine. Each clinic configures its
// own profile, locations, agents, campaigns, and intake flow; the prompt
// service composes a RetellAI-ready system prompt from these records.
// ===========================================================================

enum ReceptionistFieldType {
  FIRST_NAME
  LAST_NAME
  PHONE
  EMAIL
  PREFERRED_DATE
  PREFERRED_TIME
  PREFERRED_LOCATION
  PATIENT_STATUS
  INSURANCE_PROVIDER
  REASON_FOR_VISIT
  PREFERRED_PROVIDER
  LANGUAGE_PREFERENCE
  CONSENT
  CUSTOM_TEXT
  CUSTOM_DROPDOWN
  CUSTOM_YES_NO
}

enum ReceptionistCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ReceptionistCallOutcome {
  IN_PROGRESS
  BOOKED
  NOT_INTERESTED
  NO_ANSWER
  VOICEMAIL
  ESCALATED
  OPTED_OUT
  FAILED
}

enum ReceptionistRequestStatus {
  PENDING
  CONFIRMED
  CANCELED
  COMPLETED
  NO_SLOTS
}

enum ReceptionistOptOutChannel {
  VOICE
  SMS
  EMAIL
  ALL
}

model ReceptionistClinic {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @db.Uuid
  name                 String
  logoUrl              String?
  phone                String
  website              String?
  addressLine          String?
  timezone             String   @default("America/New_York")
  defaultLanguage      String   @default("en-US")
  complianceDisclosure String   @default("Hi, this is your AI assistant calling on behalf of the clinic.")
  humanFallbackNumber  String?
  doNotContactPolicy   String   @default("If the person asks not to be contacted again, confirm politely and mark them do-not-contact.")
  workingHours         Json?
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  tenant               Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations            ReceptionistLocation[]
  agents               ReceptionistAgent[]
  campaigns            ReceptionistCampaign[]
  appointmentRequests  ReceptionistAppointmentRequest[]
  callLogs             ReceptionistCallLog[]
  optOuts              ReceptionistOptOut[]
  outboundCampaigns    ReceptionistOutboundCampaign[]

  @@unique([tenantId, name])
  @@index([tenantId, active])
}

model ReceptionistLocation {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  clinicId     String   @db.Uuid
