generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MANAGER
  BILLING
  PROVIDER
  FRONT_DESK
  ANALYST
  COMPLIANCE_OFFICER
  AUDITOR
}

enum AppointmentStatus {
  CONFIRMED
  RISKY
  ARRIVED
  NO_SHOW
  CANCELED
  COMPLETED
  WAITLIST
}

enum LifecycleStage {
  NEW
  ACTIVE
  AT_RISK
  INACTIVE
  LOST
  RETAINED
}

enum Channel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
  CALL
  VIDEO
}

enum ConsentPurpose {
  SMS
  WHATSAPP
  EMAIL
  MARKETING
}

enum PlaybookStatus {
  DRAFT
  LIVE
  PAUSED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DISMISSED
  EXECUTED
  FAILED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  SCHEDULED
  CANCELLED
  APPROVAL_REQUIRED
  FAILED
}

enum IntegrationStatus {
  CONNECTED
  DISCONNECTED
  ERROR
  COMING_SOON
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELED
}

enum TemplateStatus {
  ACTIVE
  PAUSED
}

model Tenant {
  id                                  String                               @id @default(uuid()) @db.Uuid
  name                                String
  slug                                String                               @unique
  // Platform-controlled lifecycle status: active | suspended | cancelled.
  status                              String                               @default("active")
  // Company record, maintained by platform operators (see
  // 20260829040000_tenant_company_record). All nullable: an existing tenant has
  // no company record yet, and a blank field must read as "not recorded"
  // rather than as a fabricated value.
  legalName                           String?
  companyNumber                       String?
  addressLine1                        String?
  addressLine2                        String?
  city                                String?
  region                              String?
  postalCode                          String?
  country                             String?
  mainPhone                           String?
  website                             String?
  primaryContactName                  String?
  primaryContactEmail                 String?
  primaryContactPhone                 String?
  billingContactName                  String?
  billingContactEmail                 String?
  accountNotes                        String?

  // How this workspace is allowed to behave in the real world.
  //   demo       - nobody real is on the other end of the phone. Live calling
  //                is refused outright, so a sales demo cannot dial a patient.
  //   pilot      - a real clinic, attended operation.
  //   production - a real clinic, unattended.
  // Enforced in server/lib/tenantMode.ts at both call-admission gates. A voice
  // product needs one switch above every dial path, and this is it.
  mode                                String                               @default("pilot")

  // Relationship facts an operator needs and the console could not show. These
  // are recorded facts, not runtime switches: their job is to be visible when
  // someone asks "when does this renew" or "is the BAA signed".
  contractStartedAt                   DateTime?
  accountManager                      String?
  baaSignedAt                         DateTime?

  createdAt                           DateTime                             @default(now())
  updatedAt                           DateTime                             @updatedAt
  branches                            Branch[]
  users                               User[]
  patients                            Patient[]
  appointments                        Appointment[]
  consentEvents                       ConsentEvent[]
  auditEvents                         AuditEvent[]
  playbooks                           AutopilotPlaybook[]
  approvals                           AutopilotApproval[]
  leads                               Lead[]
  campaigns                           Campaign[]
  reviews                             Review[]
  inventoryItems                      InventoryItem[]
  partnerReports                      PartnerReport[]
  integrations                        Integration[]
  providers                           ProviderProfile[]
  staffProfiles                       StaffProfile[]
  staffTasks                          StaffTask[]
  appointmentNotes                    AppointmentNote[]
  revenueSnapshots                    RevenueSnapshot[]
  conversations                       Conversation[]
  conversationReplyAttempts           ConversationReplyAttempt[]
  revenueLeaks                        RevenueLeak[]
  opportunities                       Opportunity[]
  insurancePayers                     InsurancePayer[]
  patientInsurancePolicies            PatientInsurancePolicy[]
  eligibilityVerifications            EligibilityVerification[]
  eligibilityExecutions               EligibilityExecution[]
  benefitSnapshots                    BenefitSnapshot[]
  priorAuthorizations                 PriorAuthorization[]
  patientResponsibilityEstimates      PatientResponsibilityEstimate[]
  paymentProviderConnections          PaymentProviderConnection[]
  paymentRequests                     PaymentRequest[]
  paymentTransactions                 PaymentTransaction[]
  depositRules                        DepositRule[]
  depositRequirements                 DepositRequirement[]
  revenueProtectionAlerts             RevenueProtectionAlert[]
  integrationRunLogs                  IntegrationRunLog[]
  competitors                         Competitor[]
  competitorReviewInsights            CompetitorReviewInsight[]
  reputationCases                     ReputationCase[]
  reviewRequests                      ReviewRequest[]
  notificationTemplates               NotificationTemplate[]
  aiGuardrails                        AiGuardrail[]
  customerPreferences                 CustomerPreference[]
  roleDefinitions                     RoleDefinition[]
  userClinicAccesses                  UserClinicAccess[]
  receptionistClinics                 ReceptionistClinic[]
  receptionistLocations               ReceptionistLocation[]
  receptionistAgents                  ReceptionistAgent[]
  receptionistAgentDeployments        ReceptionistAgentDeployment[]
  receptionistCampaigns               ReceptionistCampaign[]
  receptionistIntakeFields            ReceptionistIntakeField[]
  receptionistCallLogs                ReceptionistCallLog[]
  receptionistOptOuts                 ReceptionistOptOut[]
  receptionistRecordingConsentEvents  ReceptionistRecordingConsentEvent[]
  receptionistArtifactLifecycleEvents ReceptionistArtifactLifecycleEvent[]
  receptionistCallLegalHolds          ReceptionistCallLegalHold[]
  receptionistVoiceConsentEvents      ReceptionistVoiceConsentEvent[]
  receptionistOutboundProviderIntents ReceptionistOutboundProviderIntent[]
  passwordResetTokens                 PasswordResetToken[]
  complianceFrameworks                ComplianceFramework[]
  complianceControls                  ComplianceControl[]
  complianceEvidence                  ComplianceEvidence[]
  complianceControlEvidence           ComplianceControlEvidence[]
  complianceEvidenceVersions          ComplianceEvidenceVersion[]
  compliancePolicies                  CompliancePolicy[]
  complianceRisks                     ComplianceRisk[]
  complianceTasks                     ComplianceTask[]
  complianceExceptions                ComplianceException[]
  vendorRisks                         VendorRisk[]
  securityIncidents                   SecurityIncident[]
  accessReviews                       AccessReview[]
  dataRetentionPolicies               DataRetentionPolicy[]
  backupVerifications                 BackupVerification[]
  securityScanResults                 SecurityScanResult[]
  tenantSecurityPolicy                TenantSecurityPolicy?
  schedulingPolicy                    SchedulingPolicy?
  tenantSubscription                  TenantSubscription?
  tenantSubscriptionAddons            TenantSubscriptionAddon[]
  tenantFeatureEntitlements           TenantFeatureEntitlement[]
  tenantSubscriptionRequests          TenantSubscriptionRequest[]
  receptionistOutboundCampaigns       ReceptionistOutboundCampaign[]
  receptionistCallTargets             ReceptionistCallTarget[]
  appointmentRequests                 AppointmentRequest[]
  serviceCatalogItems                 ServiceCatalogItem[]
  receptionistClosures                ReceptionistClosure[]
  receptionistClinicKnowledge         ReceptionistClinicKnowledge[]
  receptionistLocalePacks             ReceptionistLocalePack[]
  businessEvents                      BusinessEvent[]
  operationalSignals                  OperationalSignal[]
  aiRecommendations                   AIRecommendation[]
  communicationConsents               CommunicationConsent[]
  campaignSuppressions                CampaignSuppression[]
  campaignDeliveries                  CampaignDelivery[]
  intakePackets                       PatientIntakePacket[]
  intakeSections                      PatientIntakeSection[]
  intakeDocuments                     PatientIntakeDocument[]
  patientConsentRecords               PatientConsentRecord[]
  pilotImportPresets                  PilotImportPreset[]
  pilotStatusShares                   PilotStatusShare[]
  devices                             Device[]
  deviceEvents                        DeviceEvent[]
  monitoringRules                     MonitoringRule[]
  deviceReadings                      DeviceReading[]
  readingAlerts                       ReadingAlert[]
  notificationEvents                  NotificationEvent[]
  notificationDeliveryAttempts        NotificationDeliveryAttempt[]
  morningBriefingSignals              MorningBriefingSignal[]
  insuranceProviders                  InsuranceProvider[]
  deviceProviders                     DeviceProvider[]
  patientDeviceEnrollments            PatientDeviceEnrollment[]
  deviceProviderSyncLogs              DeviceProviderSyncLog[]
  patientConsents                     PatientConsent[]
  rpmBillingReadiness                 RPMBillingReadiness[]
  aiUsageLogs                         AIUsageLog[]
  aiEvaluations                       AIEvaluation[]
  portalAccessRequests                PortalAccessRequest[]
  leadActivities                      LeadActivity[]
  growthPolicy                        GrowthPolicy?
  growthSegmentDefinitions            GrowthSegmentDefinition[]
  growthChannelCosts                  GrowthChannelCost[]
  campaignSubmissionClaims            CampaignSubmissionClaim[]
  campaignLiveDispatchActivations     CampaignLiveDispatchActivation[]
  campaignAttributions                CampaignAttribution[]
  usageEvents            UsageEvent[]
}

model User {
  id                     String               @id @default(uuid()) @db.Uuid
  tenantId               String               @db.Uuid
  email                  String
  displayName            String
  role                   UserRole
  branchId               String?              @db.Uuid
  externalId             String?              @unique
  passwordHash           String?
  refreshTokenHash       String?
  refreshTokenExpiresAt  DateTime?
  lastLoginAt            DateTime?
  failedLoginCount       Int                  @default(0)
  lockedUntil            DateTime?
  passwordChangedAt      DateTime?
  mfaSecretEnc           String?
  mfaEnabled             Boolean              @default(false)
  mfaEnrolledAt          DateTime?
  active                 Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  tenant                 Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                 Branch?              @relation(fields: [branchId], references: [id], onDelete: SetNull)
  auditEvents            AuditEvent[]
  approvals              AutopilotApproval[]  @relation("ApprovalReviewer")
  staffTasks             StaffTask[]
  revenueLeaks           RevenueLeak[]
  opportunities          Opportunity[]
  providerProfile        ProviderProfile?
  staffProfile           StaffProfile?
  partnerReportsReviewed PartnerReport[]      @relation("PartnerReportReviewer")
  clinicAccesses         UserClinicAccess[]
  passwordResetTokens    PasswordResetToken[]
  approvedOutboundCampaigns ReceptionistOutboundCampaign[] @relation("OutboundAuthorityApprover")
  receptionistOptOutRevocations ReceptionistOptOut[] @relation("ReceptionistOptOutRevoker")
  receptionistVoiceConsentEvents ReceptionistVoiceConsentEvent[] @relation("ReceptionistVoiceConsentActor")
  receptionistCallsReviewed ReceptionistCallLog[] @relation("ReceptionistCallReviewer")
  receptionistCallsSignedOff ReceptionistCallLog[] @relation("ReceptionistCallSignoff")
  conversationReplyAttempts ConversationReplyAttempt[]
  eligibilityExecutions          EligibilityExecution[]          @relation("EligibilityExecutionActor")
  eligibilityReconciliationsVerified EligibilityExecution[]      @relation("EligibilityReconciliationVerifier")
  leadActivities                 LeadActivity[]                  @relation("LeadActivityActor")
  acknowledgedStaffTasks         StaffTask[]                     @relation("StaffTaskAcknowledgedBy")
  appointmentNotes               AppointmentNote[]               @relation("AppointmentNoteActor")
  receptionistClosuresCreated    ReceptionistClosure[]           @relation("ReceptionistClosureCreator")
  receptionistKnowledgeApproved  ReceptionistClinicKnowledge[]   @relation("ReceptionistKnowledgeApprover")
  receptionistKnowledgeEdited    ReceptionistClinicKnowledge[]   @relation("ReceptionistKnowledgeEditor")
  receptionistLocalePacksApproved ReceptionistLocalePack[]       @relation("ReceptionistLocalePackApprover")
  receptionistLocalePacksCreated ReceptionistLocalePack[]        @relation("ReceptionistLocalePackCreator")

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId, role])
}

model Branch {
