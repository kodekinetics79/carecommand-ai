model Lead {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @db.Uuid
  patientId           String?              @db.Uuid
  name                String
  phone               String?
  email               String?
  channel             Channel
  service             String
  stage               String
  source              String
  estimatedValue      Decimal              @default(0) @db.Decimal(12, 2)
  // Why the lead was lost, captured at the stage transition. The UI blocks the
  // user until a justification is typed and promises it is recorded, so it is
  // persisted here and echoed into the audit trail + LeadActivity history.
  lostReason          String?
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient             Patient?             @relation(fields: [patientId], references: [id], onDelete: SetNull)
  appointmentRequests AppointmentRequest[]
  receptionistCallTargets ReceptionistCallTarget[]
  receptionistVoiceConsentEvents ReceptionistVoiceConsentEvent[]
  receptionistOutboundProviderIntents ReceptionistOutboundProviderIntent[]
  activities          LeadActivity[]
  campaignAttributions CampaignAttribution[]

  @@unique([tenantId, id])
  @@index([tenantId, stage, createdAt])
}

// Append-only-by-convention history of what happened to a lead. `Lead.stage` is
// overwritten in place, so without this table a stage change leaves no trace and
// "why are we losing leads?" has no answer. One row per transition, carrying the
// operator's justification and the acting user.
model LeadActivity {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  leadId       String   @db.Uuid
  // stage_change today; the vocabulary widens as the module records more events.
  activityType String
  fromStage    String?
  toStage      String?
  reason       String?
  actorUserId  String?  @db.Uuid
  occurredAt   DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "LeadActivity_tenant_fkey")
  lead         Lead     @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Cascade, map: "LeadActivity_lead_scope_fkey")
  actorUser    User?    @relation("LeadActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, leadId, occurredAt])
  @@index([tenantId, activityType, occurredAt])
}

// ===========================================================================
// Growth configuration spine.
//
// The Growth module (CRM, segments, campaigner, reputation, competitor radar)
// compiled ~40 clinic business rules into source. These three models are the
// tenant-configurable home for them. Nothing reads them yet: the seeded values
// reproduce today's constants exactly, and the call sites are rewired in a
// later increment, so landing this changes no observable number.
//
// Threshold semantics (stated once, because ambiguity is how the module ended
// up with four different churn-risk thresholds):
//   * `...Score` / `...High` / `...Mid` / `...Good` / `...Fair` / `min...`
//     are INCLUSIVE LOWER bounds  (value >= threshold).
//   * `...SeverityMax` fields are INCLUSIVE UPPER bounds (value <= threshold).
//   * `maxInactiveDays` is an EXCLUSIVE upper bound (days < threshold), which
//     is what the 30–60 / 60–90 / 90–180 windows do today.
//   * `competitorReviewVolumeHigh` is the one EXCLUSIVE lower bound
//     (volume > threshold), preserving ClinicRadar's `reviewVolume > 350`.
// ===========================================================================

// One row per tenant. Absence = the column defaults below, which are the values
// hardcoded in the frontend today, so a tenant that never opens the editor keeps
// current behaviour (same contract as SchedulingPolicy).
model GrowthPolicy {
  id                              String   @id @default(uuid()) @db.Uuid
  tenantId                        String   @unique @db.Uuid
  // --- Lead scoring -------------------------------------------------------
  hotLeadScore                    Int      @default(70)
  scoreBandHigh                   Int      @default(70)
  scoreBandMid                    Int      @default(40)
  goingColdDays                   Int      @default(14)
  // --- Retention / patient value ------------------------------------------
  // 50 is the resolved single source of truth for "at risk". The frontend used
  // >= 50 and server/modules/patients/routes.ts still uses >= 60; that call site
  // is rewired to this column in the increment that starts reading this table.
  churnRiskHigh                   Int      @default(50)
  // Inclusive (>= 4000). The frontend used >= and the server used >, so a
  // patient at exactly 4000 was high-value on one screen and not the other.
  highValuePatientLtv             Decimal  @default(4000) @db.Decimal(12, 2)
  // Explicitly unvalidated planning assumption, not a forecast.
  recoverableLtvFraction          Decimal  @default(0.30) @db.Decimal(5, 4)
  // --- Scheduling / no-show risk ------------------------------------------
  // 50 is the resolved single source of truth for "high no-show risk"
  // (INCLUSIVE, value >= threshold). Same resolution shape as churnRiskHigh:
  // src/pages/Scheduling.tsx flagged at >= 50 (the clinic-visible rule),
  // server/modules/advisory/service.ts counted at >= 60 and priced the count,
  // and server/modules/revenue-protection.ts escalated at > 65. See
  // THRESHOLD_RESOLUTIONS in server/modules/growth/defaults.ts. Added by
  // 20260829130000_growth_policy_no_show_risk, which backfills existing rows
  // via ADD COLUMN ... DEFAULT.
  noShowRiskHigh                  Int      @default(50)
  // --- Audience planning --------------------------------------------------
  inactiveAudienceDays            Int      @default(180)
  maxAudienceSize                 Int      @default(500)
  slotFillHorizonDays             Int      @default(7)
  // --- Reputation ---------------------------------------------------------
  reviewRatingGood                Decimal  @default(4.5) @db.Decimal(3, 2)
  reviewRatingFair                Decimal  @default(4.0) @db.Decimal(3, 2)
  reputationRiskHigh              Int      @default(80)
  reputationRiskMedium            Int      @default(55)
  // --- Competitor radar ---------------------------------------------------
  competitorRatingHighSeverityMax   Decimal  @default(4.2) @db.Decimal(3, 2)
  competitorRatingMediumSeverityMax Decimal  @default(4.5) @db.Decimal(3, 2)
  competitorReviewVolumeHigh      Int      @default(350)
  // --- Outreach governance ------------------------------------------------
  leadSendCooldownHours           Int      @default(24)
  // --- Campaign attribution ------------------------------------------------
  // How long after a delivery was ACCEPTED BY THE PROVIDER an outcome may still
  // be linked to it. server/lib/campaignAttribution.ts reads this column and
  // never a literal; the value in force at the moment a link is made is copied
  // onto the CampaignAttribution row, so editing this number changes what will
  // be attributed NEXT and never what was already attributed.
  //
  // Deliberately shorter than the only two vendors who publish a number:
  // RevenueWell credits itself with all revenue from any appointment within 60
  // days of an unmatched new-patient request. 30 days is a claim that can be
  // defended one delivery at a time.
  //
  // Not carried in server/modules/growth/defaults.ts on purpose: that file's
  // contract is "the constants the browser already shipped", and its seed block
  // is pinned column-for-column by growthConfigSpine.unit.test.ts against an
  // already-applied migration. This is a NEW decision, not a transcribed one,
  // so its code-side default lives with the job that reads it
  // (CAMPAIGN_ATTRIBUTION_WINDOW_DAYS_DEFAULT) and is pinned to this @default
  // by campaignAttributionPolicy.unit.test.ts.
  campaignAttributionWindowDays   Int      @default(30)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt
  tenant                          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Multi-row: the rule-based candidate groups the Growth module offers. Membership
// is a planning candidate list, never a contact-eligibility decision — consent and
// suppression are still verified at campaign preview and dispatch.
model GrowthSegmentDefinition {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @db.Uuid
  key                   String
  label                 String
  description           String
  minInactiveDays       Int?
  maxInactiveDays       Int?
  // Today a patient with no recorded visit is treated as 9999 days inactive.
  // This flag makes that behaviour explicit instead of an accident of arithmetic.
  includeNeverVisited   Boolean  @default(false)
  minLifetimeValue      Decimal? @db.Decimal(12, 2)
  minChurnRisk          Int?
  requiredTag           String?
  suggestedChannel      String
  plannedOffer          String
  // Unvalidated planning assumption expressed as whole percent.
  assumedBookingRatePct Int      @default(0)
  active                Boolean  @default(true)
  sortOrder             Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, active, sortOrder])
}

// Planning cost per contact, per channel. Stored in integer MINOR units with an
// explicit currency: the module previously computed `count * 3` and rendered it
// through formatCurrency as "$120" for every tenant regardless of currency, and
// float money cannot be summed safely.
model GrowthChannelCost {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  channel       String
  unitCostMinor Int      @default(0)
  currency      String   @default("USD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel])
}

model Campaign {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @db.Uuid
  name             String
  goal             String
  status           CampaignStatus     @default(DRAFT)
  channels         Channel[]
  audienceSize     Int                @default(0)
  sent             Int                @default(0)
  // -------------------------------------------------------------------------
  // DEPRECATED AS WRITABLE COLUMNS. These four are a MATERIALIZED ROLLUP of
  // CampaignAttribution, maintained by database triggers
  // (Campaign_attribution_rollup_guard / CampaignAttribution_rollup_refresh in
  // migration 20260828230000_campaign_attribution). No application code path
  // may set them: the guard raises P0001 for any statement that tries to move
  // one to a value the evidence does not produce, and silently re-derives them
  // on every other write, so an ordinary campaign UPDATE cannot leave a stale
  // number behind either.
  //
  //   booked   = COUNT(CampaignAttribution WHERE outcomeType = 'booked')
  //   revenue  = SUM(attributedValue) FILTER (outcomeType = 'paid') — money a
  //              named PaymentTransaction actually recorded, never an imputed
  //              per-event constant.
  //   opened   = 0 and responded = 0, PINNED. This platform has no truthful
  //              engagement receipt: normalizeProviderDeliveryStatus in
  //              server/lib/campaignIntegrity.ts deliberately refuses to accept
  //              a provider "opened" event, so there is nothing to count. They
  //              are held at zero by construction rather than left at whatever
  //              a caller last wrote.
  //
  // Read them for display only. server/lib/campaignAttribution.ts and the
  // /v1/crm attribution endpoints derive every reported figure from the
  // CampaignAttribution rows themselves, never from these columns.
  opened           Int                @default(0)
  responded        Int                @default(0)
  booked           Int                @default(0)
  revenue          Decimal            @default(0) @db.Decimal(12, 2)
  aiGenerated      Boolean            @default(false)
  startsAt         DateTime?
  endsAt           DateTime?
  // CRM / reactivation engine (Phase A). Existing analytics fields above are
  // reused; these add playbook/approval/delivery semantics.
  //
  // Branch authority for the campaign. NULL means deliberately tenant-wide and
  // is only creatable by an operator who is not restricted to a branch; a
  // branch-restricted operator's campaign always carries their own branch. The
  // audience query, the launch preview, the launch fingerprint and dispatch all
  // resolve through this ONE column, so preview and dispatch can never disagree
  // about who is in scope. Semantics match branchScope() in server/lib/scope.ts:
  // exact match, and a NULL-branch row is out of scope for a scoped caller.
  branchId         String?            @db.Uuid
  campaignType     String?
  audienceType     String?
  campaignChannel  String?
  messageSubject   String?
  messageTemplate  String?
  draftSource      String?            @default("rule_based")
  requiresApproval Boolean            @default(true)
  approvedByUserId String?            @db.Uuid
  approvedAt       DateTime?
  scheduledAt      DateTime?
  quietHours       Json?
  createdByUserId  String?            @db.Uuid
  // Soft archive preserves delivery and audit evidence. Archived campaigns are
  // omitted from the active worklist but remain addressable for evidence review.
  archivedAt       DateTime?
  // Durable operator authority for one exact server preview. The scheduler
  // must recompute the preview and match this fingerprint before dispatch.
  dispatchAuthorizationFingerprint String?
  dispatchAuthorizedByUserId        String?   @db.Uuid
  dispatchAuthorizedAt              DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Tenant-consistent composite FK: a campaign can never be scoped to another
  // tenant's branch, and RESTRICT stops a branch deletion from silently
  // widening a scoped campaign back to tenant-wide.
  branch           Branch?            @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Restrict)
  deliveries       CampaignDelivery[]
  attributions     CampaignAttribution[]

  @@index([tenantId, status, createdAt])
  @@index([tenantId, archivedAt, createdAt])
  @@index([tenantId, branchId, createdAt])
}

