// ===========================================================================
// AI Receptionist Studio
// Configurable, multi-tenant voice-agent engine. Each clinic configures its
// own profile, locations, agents, campaigns, and intake flow; the prompt
// service composes a RetellAI-ready system prompt from these records.
// ===========================================================================

enum ReceptionistFieldType {
  FIRST_NAME
  LAST_NAME
  PHONE
  EMAIL
  PREFERRED_DATE
  PREFERRED_TIME
  PREFERRED_LOCATION
  PATIENT_STATUS
  INSURANCE_PROVIDER
  REASON_FOR_VISIT
  PREFERRED_PROVIDER
  LANGUAGE_PREFERENCE
  CONSENT
  CUSTOM_TEXT
  CUSTOM_DROPDOWN
  CUSTOM_YES_NO
}

enum ReceptionistCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ReceptionistAgentProviderStatus {
  UNVERIFIED
  VERIFIED
  INVALID
}

enum ReceptionistAgentProbeStatus {
  NEVER
  SUCCEEDED
  FAILED
}

enum ReceptionistDeploymentStatus {
  PENDING
  PUBLISHED
  VERIFIED
  FAILED
  SUPERSEDED
}

// Who asked for a provider attempt: a signed-in user, the re-verification
// worker, or a deploy (which verifies as part of its own flow).
enum ReceptionistAttemptSource {
  USER
  SYSTEM
  DEPLOY
}

enum ReceptionistCallOutcome {
  IN_PROGRESS
  BOOKED
  NOT_INTERESTED
  NO_ANSWER
  VOICEMAIL
  ESCALATED
  OPTED_OUT
  FAILED
}

enum ReceptionistCallReviewStatus {
  UNREVIEWED
  DRAFT
  REVIEWED
  SIGNED_OFF
}

enum ReceptionistOptOutChannel {
  VOICE
  SMS
