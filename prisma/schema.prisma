  RELEASED
}

model ReceptionistClinic {
  id                   String                           @id @default(uuid()) @db.Uuid
  tenantId             String                           @db.Uuid
  name                 String
  logoUrl              String?
  // Stored in canonical E.164. A partial global unique index permits only one
  // active trusted inbound destination (migration-managed; Prisma cannot
  // represent partial unique indexes in this schema).
  phone                String
  // The provider-owned inbound line THIS clinic answers on — the number a
  // deployment binds and the number verification re-reads. Backfilled from
  // `phone`, and globally unique among active clinics (migration-managed), so
  // one clinic's deploy can never repoint another clinic's line. Null means
  // "not assigned yet"; deploy claims `phone` and records the claim.
  inboundNumber        String?
  website              String?
  addressLine          String?
  // ISO-3166-1 alpha-2, uppercase (CHECK in migration). Never inferred: a null
  // country blocks activation until a human confirms it in Studio.
  country              String?
  timezone             String
  defaultLanguage      String
  // Supplemental clinic/jurisdiction sentence only; the disclosure baseline,
  // emergency wording and DNC lines come from the approved locale pack.
  complianceDisclosure String?
  // Stored in canonical E.164 (CHECK in migration); null = no transfer target.
  humanFallbackNumber  String?
  doNotContactPolicy   String?
  workingHours         Json?
  // Front desk SLA policy (C4): { sla: { <kind>: { dueMinutes, priority } } }; merged over code defaults.
  frontDeskPolicy      Json?
  active               Boolean                          @default(true)
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  tenant               Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations            ReceptionistLocation[]
  agents               ReceptionistAgent[]
  campaigns            ReceptionistCampaign[]
  callLogs             ReceptionistCallLog[]
  optOuts              ReceptionistOptOut[]
  outboundCampaigns    ReceptionistOutboundCampaign[]
  closures             ReceptionistClosure[]
  knowledge            ReceptionistClinicKnowledge?

  @@unique([tenantId, name])
  @@unique([tenantId, id])
  @@index([tenantId, active])
}

model ReceptionistLocation {
  id           String             @id @default(uuid()) @db.Uuid
  tenantId     String             @db.Uuid
  clinicId     String             @db.Uuid
  // Explicit core scheduling location. Legacy null mappings fail closed;
  // new configuration requires an active tenant-owned Branch.
  branchId     String?            @db.Uuid
  name         String
  address      String
  phone        String?
  // Parking / entrance / transit guidance spoken to callers who ask.
  accessNotes  String?
  // Per-day override of the clinic hours; null = inherit the clinic schedule.
  // The location timezone is derived from branch.timezone and never stored.
  workingHours Json?
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic       ReceptionistClinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branch       Branch?            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  closures     ReceptionistClosure[]

  @@unique([tenantId, id])
  @@index([tenantId, clinicId, active])
  @@index([tenantId, branchId, active])
}

// Planned closures (holidays, training days). Ranges are clinic-local calendar
// dates; a null locationId closes every location of the clinic. Partial-day
// columns are reserved (CHECK: both or neither) but the API rejects them.
model ReceptionistClosure {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  clinicId        String   @db.Uuid
  locationId      String?  @db.Uuid
  startsOn        DateTime @db.Date
  endsOn          DateTime @db.Date
  startTime       String?
  endTime         String?
  reason          String
  internalNote    String?
  createdByUserId String?  @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic          ReceptionistClinic    @relation(fields: [tenantId, clinicId], references: [tenantId, id], onDelete: Cascade, map: "ReceptionistClosure_clinic_scope_fkey")
  location        ReceptionistLocation? @relation(fields: [tenantId, locationId], references: [tenantId, id], onDelete: Cascade, map: "ReceptionistClosure_location_scope_fkey")
  createdBy       User?                 @relation("ReceptionistClosureCreator", fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistClosure_creator_scope_fkey")

  @@unique([tenantId, id])
  @@index([tenantId, clinicId, startsOn, endsOn])
}

// One knowledge document per clinic: an editable draft plus the approved
// snapshot the prompt renders. Approval is a set-level governance act that
// produces one hash and one approver.
model ReceptionistClinicKnowledge {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  clinicId         String    @db.Uuid
  draft            Json
  draftRevision    Int       @default(1)
  approved         Json?
  approvedRevision Int?
  approvedHash     String?
  approvedByUserId String?   @db.Uuid
  approvedAt       DateTime?
  updatedByUserId  String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic           ReceptionistClinic @relation(fields: [tenantId, clinicId], references: [tenantId, id], onDelete: Cascade, map: "ReceptionistClinicKnowledge_clinic_scope_fkey")
  approvedBy       User?              @relation("ReceptionistKnowledgeApprover", fields: [tenantId, approvedByUserId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistClinicKnowledge_approver_scope_fkey")
  updatedBy        User?              @relation("ReceptionistKnowledgeEditor", fields: [tenantId, updatedByUserId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistClinicKnowledge_editor_scope_fkey")

  @@unique([tenantId, clinicId])
  @@unique([tenantId, id])
}

enum ReceptionistLocalePackStatus {
  DRAFT
  APPROVED
  RETIRED
}

// Tenant-owned caller-facing wording per (language, country). Platform
// defaults live in code (server/lib/receptionist/localePacks/defaults.ts); a
// tenant adopts one as a DRAFT and an OWNER/ADMIN approves it. Approved
// content is immutable at the application layer (409 PACK_IMMUTABLE); a change
// is a new version. Exactly one APPROVED pack per (tenant, language, country)
// is enforced by a partial unique index in the migration.
model ReceptionistLocalePack {
  id                 String                       @id @default(uuid()) @db.Uuid
  tenantId           String                       @db.Uuid
  language           String
  country            String
  version            Int
  status             ReceptionistLocalePackStatus @default(DRAFT)
  source             String
  baseDefaultVersion Int?
  strings            Json
  evidenceHash       String
  approvedByUserId   String?                      @db.Uuid
  approvedAt         DateTime?
  retiredAt          DateTime?
  createdByUserId    String?                      @db.Uuid
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  tenant             Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvedBy         User?                 @relation("ReceptionistLocalePackApprover", fields: [tenantId, approvedByUserId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistLocalePack_approver_scope_fkey")
  createdBy          User?                 @relation("ReceptionistLocalePackCreator", fields: [tenantId, createdByUserId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistLocalePack_creator_scope_fkey")
  callLogs           ReceptionistCallLog[]

  @@unique([tenantId, language, country, version])
  @@unique([tenantId, id])
  @@index([tenantId, language, country, status])
}

model ReceptionistAgent {
  id                            String                          @id @default(uuid()) @db.Uuid
  tenantId                      String                          @db.Uuid
  clinicId                      String                          @db.Uuid
  name                          String
  // Local prompt-preview metadata. Production calls use the immutable,
  // provider-verified snapshot below and never silently override it.
  voice                         String                          @default("11labs-Adrian")
  tone                          String                          @default("Warm and professional")
  language                      String                          @default("en-US")
  persona                       String?
  greetingOverride              String?
  active                        Boolean                         @default(true)
  providerAgentId               String?
  providerVersionTag            String                          @default("prod")
  providerVersion               Int?
  providerStatus                ReceptionistAgentProviderStatus @default(UNVERIFIED)
  providerPublished             Boolean?
  providerAssignedTags          String[]                    @default([])
  providerVoiceId               String?
  providerLanguage              String?
  providerWebhookUrl            String?
  providerWebhookEvents         String[]                    @default([])
  providerDataStorageSetting    String?
  providerSignedUrl             Boolean?
  providerResponseEngineType    String?
  providerResponseEngineId      String?
  providerResponseEngineVersion Int?
  providerResponseEngineGraphFingerprint String?
  // Canonical, sanitized tag/preferred-tag defaults returned by the exact
  // provider deployment and bound into campaign attestation evidence.
  providerEffectiveDynamicVariables Json?
  // Sanitized, provider-read book_appointment JSON Schema evidence. It is
  // version-bound to the verified response engine and contains no credentials.
  providerBookToolSchema        Json?
  providerBookToolFingerprint   String?
  providerToolCallStrictMode    Boolean?
  providerLastModifiedAt        DateTime?
  providerFingerprint           String?
  providerConfigRevision        Int                             @default(1)
  providerVerifiedRevision      Int?
  providerVerifiedAt            DateTime?
  providerVerificationExpiresAt DateTime?
  providerLastAttemptAt         DateTime?
  providerLastAttemptStatus     ReceptionistAgentProbeStatus    @default(NEVER)
  providerLastAttemptSource     ReceptionistAttemptSource        @default(USER)
  providerLastErrorCode         String?
  // Prompt hash read back from the verified provider deployment. Compared with
  // the draft plan so a prompt edited in the Retell console reads as drift.
  providerPromptHash            String?
  // The deployment this agent currently runs. Null for a manually linked (BYO)
  // agent, whose prompt CareCommand cannot attest to.
  currentDeploymentId           String?                          @db.Uuid
  createdAt                     DateTime                         @default(now())
  updatedAt                     DateTime                         @updatedAt
  tenant                        Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic                        ReceptionistClinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  campaigns                     ReceptionistCampaign[]
  outboundCampaigns             ReceptionistOutboundCampaign[]
  deployments                   ReceptionistAgentDeployment[]

  @@index([tenantId, clinicId, active])
  @@index([providerAgentId, providerVersion], map: "ReceptionistAgent_provider_deployment_idx")
  @@unique([tenantId, clinicId, id])
}

model ReceptionistCampaign {
  id                  String                           @id @default(uuid()) @db.Uuid
  tenantId            String                           @db.Uuid
  clinicId            String                           @db.Uuid
  agentId             String?                          @db.Uuid
  name                String
  campaignType        String                           @default("Reactivation")
  status              ReceptionistCampaignStatus       @default(DRAFT)
  offerTitle          String
  offerDescription    String
  offerScript         String
  appointmentType     String
  bookingRules        Json?
  eligibleLocationIds String[]                         @db.Uuid
  smsConfirmation     Boolean                          @default(true)
  emailConfirmation   Boolean                          @default(false)
  // Monotonic configuration revision plus immutable activation snapshot. Any
  // intake/location/tool mutation invalidates the attestation before reuse.
  intakeSchemaRevision              Int       @default(1)
  intakeSchemaSnapshot              Json?
  intakeSchemaFingerprint           String?
  intakeToolFingerprint             String?
  intakeSchemaAttestedRevision      Int?
  intakeSchemaAttestedAt            DateTime?
  intakeSchemaProviderAgentId       String?
  intakeSchemaProviderVersion       Int?
  intakeSchemaResponseEngineId      String?
  intakeSchemaResponseEngineVersion Int?
  // Locale pack bound at activation; the retire guard reads it. Prompt, hours
  // and knowledge hashes are attested on the agent deployment row (C5).
  attestedLocalePackId              String?   @db.Uuid
  attestedLocalePackHash            String?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt
  tenant              Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic              ReceptionistClinic               @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  agent               ReceptionistAgent?               @relation(fields: [tenantId, clinicId, agentId], references: [tenantId, clinicId, id], onDelete: Restrict, map: "ReceptionistCampaign_agent_scope_fkey")
  intakeFields        ReceptionistIntakeField[]
  callLogs            ReceptionistCallLog[]
  outboundAuthorityCampaigns ReceptionistOutboundCampaign[] @relation("OutboundBookingAuthority")
  deployments         ReceptionistAgentDeployment[]

  @@index([tenantId, clinicId, status])
  @@unique([tenantId, clinicId, id])
  @@unique([tenantId, id])
}

// One CareCommand-authored deployment of a campaign's prompt/tools to Retell.
// The row is the deployment record AND the provider evidence: mock mode answers
// its probe from these columns, so the API, the worker and the seed can never
// disagree about what the provider is running.
model ReceptionistAgentDeployment {
  id                   String                       @id @default(uuid()) @db.Uuid
  tenantId             String                       @db.Uuid
  clinicId             String                       @db.Uuid
  agentId              String                       @db.Uuid
  campaignId           String                       @db.Uuid
  status               ReceptionistDeploymentStatus @default(PENDING)
  // True when the deployment was made against the mock provider. Enforced
  // against the hash prefixes by a CHECK so mock evidence can never be read as
  // live evidence.
  mock                 Boolean                      @default(false)
  providerAgentId      String?
  providerLlmId        String?
  providerLlmVersion   Int?
  // The exact published agent version this deployment pins. Retell has no
  // public tag-assignment write, so the number is the binding, not the tag.
  providerAgentVersion Int?
  providerVersionTag   String                       @default("prod")
  promptHash           String
  beginMessageHash     String
  toolFingerprint      String
  intakeFingerprint    String
  intakeSchemaRevision Int
  configFingerprint    String
  voiceId              String
  language             String
  // Deployed prompt and tools: tenant configuration, never PHI. Kept so the
  // draft-versus-deployed comparison is a fact and not a re-derivation.
  promptText           String
  toolsJson            Json
  steps                Json?
  providerErrorCode    String?
  // `numberBound` and `boundPhoneNumber` are what the deploy ASKED the provider
  // for. Everything below is what the provider ANSWERED when asked again, and
  // it is the only evidence readiness may pass `number_bound` on: a stored
  // claim we wrote ourselves is not an attestation.
  numberBound          Boolean                      @default(false)
  boundPhoneNumber     String?
  // When the provider was last asked who answers `boundPhoneNumber`.
  numberBindingReadAt  DateTime?
  // Who the provider says answers it, read back verbatim.
  numberBindingAgentId String?
  numberBindingAgentVersion Int?
  // Non-null ONLY when that read-back named this deployment's own published
  // agent and version. Stale or null ⇒ `pending`; it may never read `pass`.
  numberBindingVerifiedAt   DateTime?
  // Why the read-back could not be completed, or `number_bound_elsewhere` when
  // it completed and named somebody else.
  numberBindingErrorCode    String?
  deployedById         String?                      @db.Uuid
  deployedBySource     ReceptionistAttemptSource    @default(USER)
  startedAt            DateTime                     @default(now())
  publishedAt          DateTime?
  verifiedAt           DateTime?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  tenant               Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agent                ReceptionistAgent            @relation(fields: [tenantId, clinicId, agentId], references: [tenantId, clinicId, id], onDelete: Cascade, map: "ReceptionistAgentDeployment_agent_scope_fkey")
  campaign             ReceptionistCampaign         @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Cascade, map: "ReceptionistAgentDeployment_campaign_scope_fkey")

  @@unique([tenantId, id])
  @@index([tenantId, agentId, createdAt])
  @@index([tenantId, campaignId, status])
  @@index([providerAgentId, providerAgentVersion])
  @@index([tenantId, boundPhoneNumber, status])
}

model ReceptionistIntakeField {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @db.Uuid
  campaignId           String                @db.Uuid
  fieldType            ReceptionistFieldType
