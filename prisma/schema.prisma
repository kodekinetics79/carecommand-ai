  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  tenant            Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic            ReceptionistClinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  agent             ReceptionistAgent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)
  intakeFields      ReceptionistIntakeField[]
  appointmentRequests ReceptionistAppointmentRequest[]
  callLogs          ReceptionistCallLog[]

  @@index([tenantId, clinicId, status])
}

