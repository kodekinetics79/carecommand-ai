  revokedByUserId String?                 @db.Uuid
  revocationReason String?
  tenant       Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic       ReceptionistClinic?       @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  revokedBy     User?                     @relation("ReceptionistOptOutRevoker", fields: [tenantId, revokedByUserId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, createdAt])
}

// Append-only evidence for outbound voice permission. The database requires
// exactly one patient/lead identity and freezes every field after insertion.
// A later grant or revocation is a new event, never an overwrite.
model ReceptionistVoiceConsentEvent {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @db.Uuid
  patientId          String?   @db.Uuid
  leadId             String?   @db.Uuid
  purpose            String
  granted            Boolean
  policyVersion      String
  disclosureTextHash String
  evidenceReference  String
  captureMethod      String
  source             String
  actorUserId        String?   @db.Uuid
  jurisdiction       String?
  expiresAt          DateTime?
  occurredAt         DateTime  @default(now())
  createdAt          DateTime  @default(now())
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient            Patient?  @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistVoiceConsentEvent_patient_scope_fkey")
  lead               Lead?     @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistVoiceConsentEvent_lead_scope_fkey")
  actorUser          User?     @relation("ReceptionistVoiceConsentActor", fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistVoiceConsentEvent_actor_scope_fkey")
  providerIntents    ReceptionistOutboundProviderIntent[]

  @@unique([tenantId, id])
  @@index([tenantId, patientId, purpose, policyVersion, occurredAt(sort: Desc), granted(sort: Asc), id(sort: Desc)], map: "ReceptionistVoiceConsentEvent_patient_lookup_idx")
  @@index([tenantId, leadId, purpose, policyVersion, occurredAt(sort: Desc), granted(sort: Asc), id(sort: Desc)], map: "ReceptionistVoiceConsentEvent_lead_lookup_idx")
}

// Authoritative, append-only commit marker immediately preceding an outbound
// provider request. Its insert trigger holds suppression fences and rechecks
// destination, identity, campaign purpose/policy, and compatible consent.
model ReceptionistOutboundProviderIntent {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid
  callLogId             String    @db.Uuid
  outboundCampaignId    String    @db.Uuid
  targetId              String?   @db.Uuid
  patientId             String?   @db.Uuid
  leadId                String?   @db.Uuid
  voiceConsentEventId   String?   @db.Uuid
  destinationCanonical  String
  identityUpdatedAt     DateTime
  correlationNonceHash  String
  boundaryVersion       Int       @default(1)
  purpose               String
  policyVersion         String
  authorizedAt          DateTime  @default(now())
  createdAt             DateTime  @default(now())
  tenant                Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  callLog               ReceptionistCallLog @relation(fields: [tenantId, outboundCampaignId, callLogId], references: [tenantId, outboundCampaignId, id], onDelete: Restrict, map: "ReceptionistOutboundProviderIntent_call_campaign_scope_fkey")
  outboundCampaign      ReceptionistOutboundCampaign @relation(fields: [tenantId, outboundCampaignId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistOutboundProviderIntent_campaign_scope_fkey")
  target                ReceptionistCallTarget? @relation(fields: [tenantId, outboundCampaignId, targetId], references: [tenantId, campaignId, id], onDelete: Restrict, map: "ReceptionistOutboundProviderIntent_target_ownership_fkey")
  patient               Patient? @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistOutboundProviderIntent_patient_scope_fkey")
  lead                  Lead? @relation(fields: [tenantId, leadId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistOutboundProviderIntent_lead_scope_fkey")
  voiceConsentEvent     ReceptionistVoiceConsentEvent? @relation(fields: [tenantId, voiceConsentEventId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistOutboundProviderIntent_consent_scope_fkey")

  @@unique([tenantId, callLogId])
  @@unique([tenantId, outboundCampaignId, callLogId], map: "ReceptionistOutboundProviderIntent_call_campaign_key")
  @@unique([tenantId, correlationNonceHash], map: "ReceptionistOutboundProviderIntent_nonce_hash_key")
  @@index([tenantId, outboundCampaignId, authorizedAt], map: "ReceptionistOutboundProviderIntent_campaign_idx")
  @@index([tenantId, targetId, authorizedAt], map: "ReceptionistOutboundProviderIntent_target_idx")
}

// ===========================================================================
// Idempotency
// DB-backed idempotency guard for payment creation and inbound webhooks.
// A successful claim inserts a unique (scope,key); redelivery hits the unique
// constraint and is treated as already-processed. resultId lets callers return
// the original result on replay.
// ===========================================================================
model IdempotencyKey {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  scope     String
  key       String
  resultId  String?
  createdAt DateTime @default(now())

  @@unique([scope, key])
  @@index([tenantId, scope])
}

// ===========================================================================
// Compliance Readiness Center (Phase C-1A: schema only)
// All tables are tenant-scoped and RLS-READY (non-null tenantId @db.Uuid,
// Tenant FK) but RLS is NOT enabled in this phase. User ownership/actor fields
// are soft UUID references (no FK) to avoid bloating User with back-relations;
// intra-compliance relations are real FKs. Reuses the existing AuditEvent for
// the audit trail — no AuditLog table is added. Nothing here claims immutability
// or certification ("SOC 2 Readiness" / "HIPAA Alignment" only).
// ===========================================================================

enum ComplianceControlStatus {
  IMPLEMENTED
  IN_PROGRESS
  NOT_IMPLEMENTED
  NOT_APPLICABLE
}

enum ComplianceReviewStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ComplianceRiskStatus {
  OPEN
  MITIGATING
  ACCEPTED
  CLOSED
}

model ComplianceFramework {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  key         String
  name        String
  description String
  weight      Int                 @default(1)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  controls    ComplianceControl[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model ComplianceControl {
  id              String                      @id @default(uuid()) @db.Uuid
  tenantId        String                      @db.Uuid
  frameworkId     String                      @db.Uuid
  categoryKey     String
  controlKey      String
  title           String
  description     String
  status          ComplianceControlStatus     @default(NOT_IMPLEMENTED)
  ownerUserId     String?                     @db.Uuid
  lastReviewedAt  DateTime?
  notes           String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  framework       ComplianceFramework         @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  controlEvidence ComplianceControlEvidence[]
  tasks           ComplianceTask[]
  exceptions      ComplianceException[]

  @@unique([tenantId, frameworkId, controlKey])
  @@index([tenantId, status])
  @@index([tenantId, categoryKey])
}

model ComplianceEvidence {
  id              String                      @id @default(uuid()) @db.Uuid
  tenantId        String                      @db.Uuid
  title           String
  description     String?
  ownerUserId     String?                     @db.Uuid
  reviewStatus    ComplianceReviewStatus      @default(PENDING)
  sourceType      String                      @default("manual")
  externalUrl     String?
  contentHash     String?
  auditorNotes    String?
  expiresAt       DateTime?
  reviewedAt      DateTime?
  deletedAt       DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  tenant          Tenant                      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  controlEvidence ComplianceControlEvidence[]
  versions        ComplianceEvidenceVersion[]

  @@index([tenantId, reviewStatus])
  @@index([tenantId, expiresAt])
  @@index([tenantId, deletedAt])
}

model ComplianceControlEvidence {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @db.Uuid
  controlId  String             @db.Uuid
  evidenceId String             @db.Uuid
  createdAt  DateTime           @default(now())
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  control    ComplianceControl  @relation(fields: [controlId], references: [id], onDelete: Cascade)
  evidence   ComplianceEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([controlId, evidenceId])
  @@index([tenantId])
}

model ComplianceEvidenceVersion {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @db.Uuid
  evidenceId  String             @db.Uuid
  version     Int
  changeType  String
  contentHash String
  prevHash    String?
  rowHash     String
  actorUserId String?            @db.Uuid
  metadata    Json?
  createdAt   DateTime           @default(now())
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  evidence    ComplianceEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, version])
  @@index([tenantId, evidenceId])
}

model CompliancePolicy {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  name             String
  version          String    @default("1.0")
  status           String    @default("draft")
  externalUrl      String?
  content          String?
  approvedByUserId String?   @db.Uuid
  effectiveAt      DateTime?
  reviewAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name, version])
  @@index([tenantId, status])
}

model ComplianceRisk {
  id             String               @id @default(uuid()) @db.Uuid
  tenantId       String               @db.Uuid
  title          String
  description    String?
  categoryKey    String
  likelihood     String               @default("medium")
  impact         String               @default("medium")
  score          Int                  @default(0)
  status         ComplianceRiskStatus @default(OPEN)
  ownerUserId    String?              @db.Uuid
  mitigationPlan String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  tenant         Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks          ComplianceTask[]

  @@index([tenantId, status])
}

model ComplianceTask {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  title          String
  description    String?
  controlId      String?            @db.Uuid
  riskId         String?            @db.Uuid
  assigneeUserId String?            @db.Uuid
  dueAt          DateTime?
  status         TaskStatus         @default(OPEN)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  control        ComplianceControl? @relation(fields: [controlId], references: [id], onDelete: SetNull)
  risk           ComplianceRisk?    @relation(fields: [riskId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
}

model ComplianceException {
  id               String             @id @default(uuid()) @db.Uuid
  tenantId         String             @db.Uuid
  controlId        String?            @db.Uuid
  title            String
  reason           String
  approvedByUserId String?            @db.Uuid
  expiresAt        DateTime?
  status           String             @default("active")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  control          ComplianceControl? @relation(fields: [controlId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
}

model VendorRisk {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  vendorName      String
  category        String?
  dataAccessLevel String?
  baaStatus       String    @default("unknown")
  riskTier        String    @default("medium")
  lastReviewedAt  DateTime?
  nextReviewAt    DateTime?
  status          String    @default("active")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model SecurityIncident {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  title            String
  severity         String    @default("low")
  status           String    @default("open")
  detectedAt       DateTime  @default(now())
  resolvedAt       DateTime?
  summary          String?
  affectedScope    String?
  timeline         Json?
  reportedByUserId String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, detectedAt])
}

model AccessReview {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  period         String
  reviewerUserId String?   @db.Uuid
  status         String    @default("pending")
  findings       Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

model DataRetentionPolicy {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  dataClass     String
  retentionDays Int
  legalBasis    String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dataClass])
  @@index([tenantId])
}

model BackupVerification {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  runAt            DateTime @default(now())
  type             String   @default("database")
  status           String   @default("unverified")
  location         String?
  verifiedByUserId String?  @db.Uuid
  details          Json?
  createdAt        DateTime @default(now())
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, runAt])
}

model SecurityScanResult {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  scanner        String
  scanAt         DateTime @default(now())
  severityCounts Json?
  reportUrl      String?
  status         String   @default("pending")
  createdAt      DateTime @default(now())
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, scanAt])
}

model TenantSecurityPolicy {
  id                      String    @id @default(uuid()) @db.Uuid
  tenantId                String    @unique @db.Uuid
  requireMfa              Boolean   @default(false)
  passwordExpiryDays      Int?
  sessionTimeoutMinutes   Int       @default(15)
  failedLoginLockout      Boolean   @default(false)
  allowedIpRanges         String[]
  dataRetentionDays       Int       @default(2555)
  backupFrequency         String    @default("daily")
  evidenceReviewFrequency String    @default("quarterly")
  // Platform-triggered "revoke all sessions": access tokens issued before this
  // instant are rejected by the tenant authenticate hook.
  sessionsRevokedAt       DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
}

// ===========================================================================
// Commercial layer — Subscription plans, add-ons, and feature entitlements.
// Catalog tables (SubscriptionPlan/Feature/Addon) are platform-global (no
// tenantId). Tenant-scoped tables carry a non-null tenantId and are RLS-READY
// (RLS not enabled in this phase). Entitlements are resolved into
// TenantFeatureEntitlement for fast guard lookups.
// ===========================================================================

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

model SubscriptionPlan {
  id                   String                      @id @default(uuid()) @db.Uuid
  key                  String                      @unique
  name                 String
  description          String
  tier                 Int                         @default(0)
  monthlyPrice         Decimal?                    @db.Decimal(10, 2)
  active               Boolean                     @default(true)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  features             SubscriptionPlanFeature[]
  tenantSubscriptions  TenantSubscription[]
  subscriptionRequests TenantSubscriptionRequest[]
}

model SubscriptionPlanFeature {
  id         String           @id @default(uuid()) @db.Uuid
  planId     String           @db.Uuid
  featureKey String
  included   Boolean          @default(true)
  limitValue Int?
  note       String?
  plan       SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, featureKey])
}

model SubscriptionAddon {
  id           String                    @id @default(uuid()) @db.Uuid
  key          String                    @unique
  name         String
  description  String
  featureKey   String?
  active       Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  tenantAddons TenantSubscriptionAddon[]
}

model TenantSubscription {
  id               String                    @id @default(uuid()) @db.Uuid
  tenantId         String                    @unique @db.Uuid
  planId           String                    @db.Uuid
  status           SubscriptionStatus        @default(TRIAL)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  startedAt        DateTime                  @default(now())
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan             SubscriptionPlan          @relation(fields: [planId], references: [id], onDelete: Restrict)
  addons           TenantSubscriptionAddon[]

  @@index([tenantId])
}

model TenantSubscriptionAddon {
  id             String             @id @default(uuid()) @db.Uuid
  tenantId       String             @db.Uuid
  subscriptionId String             @db.Uuid
  addonId        String             @db.Uuid
  active         Boolean            @default(true)
  quantity       Int                @default(1)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addon          SubscriptionAddon  @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, addonId])
  @@index([tenantId])
}

model TenantFeatureEntitlement {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  featureKey String
  enabled    Boolean  @default(false)
  source     String   @default("plan")
  limitValue Int?
  // A platform operator's explicit decision for this feature, independent of
  // the plan. null = no override. `enabled` above is the RESOLVED answer, which
  // a recompute rewrites; this column is what makes an override survive a plan
  // change, a suspension and a reactivation instead of being silently wiped.
  overrideEnabled Boolean?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureKey])
  @@index([tenantId, enabled])
}

enum SubscriptionRequestType {
  UPGRADE
  DOWNGRADE
  ADDON_CHANGE
  CANCEL
}

enum SubscriptionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model TenantSubscriptionRequest {
  id                 String                    @id @default(uuid()) @db.Uuid
  tenantId           String                    @db.Uuid
  requestedPlanId    String?                   @db.Uuid
  requestedAddonKeys String[]
  requestType        SubscriptionRequestType
  status             SubscriptionRequestStatus @default(PENDING)
  requestedByUserId  String?                   @db.Uuid
  reviewedByUserId   String?                   @db.Uuid
  notes              String?
  reviewerNote       String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedPlan      SubscriptionPlan?         @relation(fields: [requestedPlanId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([status, createdAt])
}

// ===========================================================================
// AI Receptionist — outbound calling (Phase A). Tenant-scoped, RLS-ready
// (RLS not enabled in this phase).
// ===========================================================================

enum OutboundCampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  FAILED
}

enum CallTargetStatus {
  PENDING
  CALLING
  COMPLETED
  FAILED
  OPTED_OUT
}

enum OutboundBookingMode {
  APPOINTMENT_REQUEST_ONLY
  DIRECT_BOOKING_IF_SLOT_AVAILABLE
}

enum AppointmentRequestStatus {
  PENDING_REVIEW
  BOOKED
  REJECTED
  MISSING_INFO
  DUPLICATE
}

model ReceptionistOutboundCampaign {
  id                      String                   @id @default(uuid()) @db.Uuid
  tenantId                String                   @db.Uuid
  clinicId                String                   @db.Uuid
  agentId                 String?                  @db.Uuid
  receptionistCampaignId  String?                  @db.Uuid
  name                    String
  script                  String
  purpose                 String?
  legalBasis              String?
  policyVersion           String?
  authorityApprovedAt     DateTime?
  authorityApprovedById   String?                  @db.Uuid
  authorityFingerprint    String?
  requiredFields          String[]
  customQuestions         Json?
  consentText             String?
  humanHandoffInstruction String?
  bookingMode             OutboundBookingMode      @default(APPOINTMENT_REQUEST_ONLY)
  defaultBranchId         String?                  @db.Uuid
  defaultService          String?
  quietHoursStart         String?
  quietHoursEnd           String?
  maxRetryAttempts        Int                      @default(1)
  status                  OutboundCampaignStatus   @default(DRAFT)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  tenant                  Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic                  ReceptionistClinic       @relation(fields: [tenantId, clinicId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistOutboundCampaign_clinic_scope_fkey")
  agent                   ReceptionistAgent?       @relation(fields: [tenantId, clinicId, agentId], references: [tenantId, clinicId, id], onDelete: Restrict, map: "ReceptionistOutboundCampaign_agent_scope_fkey")
  receptionistCampaign    ReceptionistCampaign?    @relation("OutboundBookingAuthority", fields: [tenantId, clinicId, receptionistCampaignId], references: [tenantId, clinicId, id], onDelete: Restrict, map: "ReceptionistOutboundCampaign_booking_authority_fkey")
  authorityApprovedBy     User?                     @relation("OutboundAuthorityApprover", fields: [tenantId, authorityApprovedById], references: [tenantId, id], onDelete: Restrict)
  defaultBranch           Branch?                   @relation("ReceptionistOutboundDefaultBranch", fields: [tenantId, defaultBranchId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistOutboundCampaign_default_branch_scope_fkey")
  targets                 ReceptionistCallTarget[]
  callLogs                ReceptionistCallLog[]
  providerIntents         ReceptionistOutboundProviderIntent[]

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, clinicId])
  @@index([tenantId, receptionistCampaignId])
}

model ReceptionistCallTarget {
  id            String                       @id @default(uuid()) @db.Uuid
  tenantId      String                       @db.Uuid
  campaignId    String                       @db.Uuid
  patientId     String?                      @db.Uuid
  leadId        String?                      @db.Uuid
  firstName     String?
  lastName      String?
  phone         String
  email         String?
  status        CallTargetStatus             @default(PENDING)
  attempts      Int                          @default(0)
  lastCallLogId String?                      @db.Uuid
  lastOutcome   String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  tenant        Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign      ReceptionistOutboundCampaign @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistCallTarget_campaign_scope_fkey")
  patient       Patient?                     @relation(fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistCallTarget_patient_scope_fkey")
