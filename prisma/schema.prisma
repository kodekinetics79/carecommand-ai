  assignedToId String?    @db.Uuid
  title        String
  priority     String
  status       TaskStatus @default(OPEN)
  dueAt        DateTime?
  metadata     Json?
  // C4 front desk loop: durable links and the human-closed outcome. Composite
  // tenant-scoped FKs (Restrict: SET NULL on a composite FK would null tenantId).
  patientId        String?   @db.Uuid
  callLogId        String?   @db.Uuid
