  patient        Patient?             @relation("StaffTaskPatient", fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, map: "StaffTask_patient_scope_fkey")
  callLog        ReceptionistCallLog? @relation("StaffTaskSourceCall", fields: [tenantId, callLogId], references: [tenantId, id], onDelete: Restrict, map: "StaffTask_callLog_scope_fkey")
  acknowledgedBy User?                @relation("StaffTaskAcknowledgedBy", fields: [tenantId, acknowledgedById], references: [tenantId, id], onDelete: Restrict, map: "StaffTask_acknowledgedBy_scope_fkey")

  @@unique([tenantId, id])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, assignedToId, status])
  @@index([tenantId, callLogId])
  @@index([tenantId, patientId, status])
}

