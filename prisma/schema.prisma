  tenantId           String                    @db.Uuid
  branchId           String                    @db.Uuid
  patientId          String                    @db.Uuid
  payerId            String?                   @db.Uuid
  planName           String
  memberId           String
  groupNumber        String?
  relationship       String?
  subscriberName     String?
  payerReference     String?
  coverageOrder      Int                       @default(1) // 1 = primary, 2 = secondary; ordered benefits coordination
