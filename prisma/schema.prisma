  voice           String   @default("11labs-Adrian")
  tone            String   @default("Warm and professional")
  language        String   @default("en-US")
  persona         String?
  greetingOverride String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic          ReceptionistClinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  campaigns       ReceptionistCampaign[]
  outboundCampaigns ReceptionistOutboundCampaign[]

  @@index([tenantId, clinicId, active])
}

model ReceptionistCampaign {
  id                String                     @id @default(uuid()) @db.Uuid
  tenantId          String                     @db.Uuid
  clinicId          String                     @db.Uuid
  agentId           String?                    @db.Uuid
  name              String
  campaignType      String                     @default("Reactivation")
  status            ReceptionistCampaignStatus @default(DRAFT)
  offerTitle        String
  offerDescription  String
  offerScript       String
  appointmentType   String
  bookingRules      Json?
  eligibleLocationIds String[]                 @db.Uuid
  smsConfirmation   Boolean                    @default(true)
