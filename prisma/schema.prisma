  phone        String?
  timezone     String?
  workingHours Json?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic       ReceptionistClinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([tenantId, clinicId, active])
}

