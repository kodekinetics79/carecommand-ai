model Patient {
  id                             String                          @id @default(uuid()) @db.Uuid
  tenantId                       String                          @db.Uuid
  branchId                       String                          @db.Uuid
  externalRef                    String?
  firstName                      String
  lastName                       String
  // Front-desk demographic capture / patient verification. Nullable + additive;
  // date-only (no time component) so no timezone ambiguity on a birthdate.
  dateOfBirth                    DateTime?                       @db.Date
  email                          String?
  phone                          String?
  lifecycleStage                 LifecycleStage                  @default(NEW)
  churnRisk                      Int                             @default(0)
  eligibilityStatus              String?
  eligibilityLastVerifiedAt      DateTime?
  lifetimeValue                  Decimal                         @default(0) @db.Decimal(12, 2)
  outstandingBalance             Decimal                         @default(0) @db.Decimal(12, 2)
  tags                           String[]
  lastVisitAt                    DateTime?
  nextVisitAt                    DateTime?
  deletedAt                      DateTime?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  tenant                         Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                         Branch                          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  appointments                   Appointment[]
  consentEvents                  ConsentEvent[]
  leads                          Lead[]
  reviews                        Review[]
  partnerReports                 PartnerReport[]
  conversations                  Conversation[]
  revenueLeaks                   RevenueLeak[]
  opportunities                  Opportunity[]
  patientInsurancePolicies       PatientInsurancePolicy[]
  eligibilityVerifications       EligibilityVerification[]
  eligibilityExecutions          EligibilityExecution[]
  priorAuthorizations            PriorAuthorization[]
  patientResponsibilityEstimates PatientResponsibilityEstimate[]
  paymentRequests                PaymentRequest[]
  appointmentRequests            AppointmentRequest[]
  paymentTransactions            PaymentTransaction[]
  depositRequirements            DepositRequirement[]
  revenueProtectionAlerts        RevenueProtectionAlert[]
  reputationCases                ReputationCase[]
  reviewRequests                 ReviewRequest[]

  communicationConsents CommunicationConsent[]
  receptionistVoiceConsentEvents ReceptionistVoiceConsentEvent[]
  campaignSuppressions  CampaignSuppression[]
  intakePackets         PatientIntakePacket[]
  patientConsentRecords PatientConsentRecord[]
  campaignAttributions  CampaignAttribution[]
  notificationEvents    NotificationEvent[]
  receptionistCallTargets ReceptionistCallTarget[]
  receptionistOutboundProviderIntents ReceptionistOutboundProviderIntent[]
  staffTasks            StaffTask[]                          @relation("StaffTaskPatient")
  receptionistCallLogs  ReceptionistCallLog[]                @relation("ReceptionistCallLogPatient")

  @@unique([tenantId, externalRef])
  @@unique([tenantId, id])
  @@index([tenantId, branchId, deletedAt])
  @@index([tenantId, lifecycleStage, churnRisk])
}

model Appointment {
  id                             String                          @id @default(uuid()) @db.Uuid
  tenantId                       String                          @db.Uuid
  branchId                       String                          @db.Uuid
  patientId                      String                          @db.Uuid
  // Canonical provider link used for conflict detection across ALL booking
  // paths (scheduling, portal self-book, staff). providerRef stays as an
  // optional free-text display label for backward compatibility.
  providerProfileId              String?                         @db.Uuid
  providerRef                    String?
  service                        String
  serviceCatalogItemId           String?                         @db.Uuid
  // Trusted source call for an autonomous receptionist booking. Nullable for
  // legacy/staff-created appointments; unique per tenant whenever present.
  receptionistCallLogId          String?                         @db.Uuid
  startsAt                       DateTime
  endsAt                         DateTime
  status                         AppointmentStatus               @default(CONFIRMED)
  channel                        Channel
  value                          Decimal                         @default(0) @db.Decimal(12, 2)
  noShowRisk                     Int                             @default(0)
  eligibilityStatus              String?
  eligibilityLastVerifiedAt      DateTime?
  notes                          String?
  deletedAt                      DateTime?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  tenant                         Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                         Branch                          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient                        Patient                         @relation(fields: [patientId], references: [id], onDelete: Restrict)
  eligibilityVerifications       EligibilityVerification[]
  eligibilityExecutions          EligibilityExecution[]
  priorAuthorizations            PriorAuthorization[]
  patientResponsibilityEstimates PatientResponsibilityEstimate[]
  paymentRequests                PaymentRequest[]
  paymentTransactions            PaymentTransaction[]
  depositRequirements            DepositRequirement[]
  revenueProtectionAlerts        RevenueProtectionAlert[]
  serviceCatalogItem             ServiceCatalogItem?             @relation(fields: [serviceCatalogItemId], references: [id], onDelete: SetNull)
  providerProfile                ProviderProfile?                @relation(fields: [providerProfileId], references: [id], onDelete: Restrict)
  sourceCallLog                  ReceptionistCallLog?             @relation("AppointmentSourceCall", fields: [tenantId, receptionistCallLogId], references: [tenantId, id], onDelete: Restrict)
  appointmentRequests            AppointmentRequest[]             @relation("AppointmentRequestBookedAppointment")
  notificationEvents             NotificationEvent[]
  campaignAttributions           CampaignAttribution[]
  // Append-only note history (C4). The scalar `notes` string stays for old readers.
  noteEntries                    AppointmentNote[]

  @@unique([tenantId, id])
  @@unique([tenantId, receptionistCallLogId])
  @@index([tenantId, branchId, startsAt])
  @@index([tenantId, patientId, startsAt])
  @@index([tenantId, status, startsAt])
  @@index([tenantId, providerProfileId, startsAt])
}

// ===========================================================================
// Append-only appointment notes (C4 front desk loop). Staff, the voice agent,
// and the system append; nothing updates or deletes at runtime (REVOKE-backed,
// listed in TENANT_APPEND_ONLY_TABLES). Every FK is tenant-scoped so a note can
// never point at another tenant's appointment, actor, or source call.
// ===========================================================================
model AppointmentNote {
  id            String               @id @default(uuid()) @db.Uuid
  tenantId      String               @db.Uuid
  appointmentId String               @db.Uuid
  text          String
  // staff | voice_agent | system (DB CHECK)
  actorType     String
  actorUserId   String?              @db.Uuid
  callLogId     String?              @db.Uuid
  createdAt     DateTime             @default(now())
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, map: "AppointmentNote_tenant_fkey")
  appointment   Appointment          @relation(fields: [tenantId, appointmentId], references: [tenantId, id], onDelete: Cascade, map: "AppointmentNote_appointment_scope_fkey")
  actorUser     User?                @relation("AppointmentNoteActor", fields: [tenantId, actorUserId], references: [tenantId, id], onDelete: Restrict, map: "AppointmentNote_actor_scope_fkey")
  callLog       ReceptionistCallLog? @relation("AppointmentNoteSourceCall", fields: [tenantId, callLogId], references: [tenantId, id], onDelete: Restrict, map: "AppointmentNote_callLog_scope_fkey")

  @@index([tenantId, appointmentId, createdAt])
  @@index([tenantId, callLogId])
}

model ConsentEvent {
  id         String         @id @default(uuid()) @db.Uuid
  tenantId   String         @db.Uuid
  patientId  String         @db.Uuid
  purpose    ConsentPurpose
  granted    Boolean
  source     String
  occurredAt DateTime       @default(now())
  metadata   Json?
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  patient    Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId, purpose, occurredAt])
}

model AutopilotPlaybook {
  id          String              @id @default(uuid()) @db.Uuid
  tenantId    String              @db.Uuid
  key         String
  name        String
  description String
  status      PlaybookStatus      @default(DRAFT)
  config      Json
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  approvals   AutopilotApproval[]

  @@unique([tenantId, key])
  @@index([tenantId, status])
}

model AutopilotApproval {
  id           String            @id @default(uuid()) @db.Uuid
  tenantId     String            @db.Uuid
  playbookId   String            @db.Uuid
  title        String
  reason       String
  payload      Json
  confidence   Int
  status       ApprovalStatus    @default(PENDING)
  reviewedById String?           @db.Uuid
  reviewedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  playbook     AutopilotPlaybook @relation(fields: [playbookId], references: [id], onDelete: Restrict)
  reviewedBy   User?             @relation("ApprovalReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status, createdAt])
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  resource    String
  resourceId  String?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  occurredAt  DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, occurredAt])
  @@index([tenantId, resource, resourceId])
