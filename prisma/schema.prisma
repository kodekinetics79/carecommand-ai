  location                       String
  timezone                       String                          @default("Europe/London")
  active                         Boolean                         @default(true)
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  tenant                         Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                          User[]
  patients                       Patient[]
  appointments                   Appointment[]
  inventoryItems                 InventoryItem[]
  partnerReports                 PartnerReport[]
  staffTasks                     StaffTask[]
  revenueSnapshots               RevenueSnapshot[]
  conversations                  Conversation[]
  reviews                        Review[]
  revenueLeaks                   RevenueLeak[]
  opportunities                  Opportunity[]
  patientInsurancePolicies       PatientInsurancePolicy[]
  eligibilityVerifications       EligibilityVerification[]
  eligibilityExecutions                EligibilityExecution[]
  benefitSnapshots               BenefitSnapshot[]
  priorAuthorizations            PriorAuthorization[]
  patientResponsibilityEstimates PatientResponsibilityEstimate[]
  paymentRequests                PaymentRequest[]
  paymentTransactions            PaymentTransaction[]
  depositRules                   DepositRule[]
  depositRequirements            DepositRequirement[]
  revenueProtectionAlerts        RevenueProtectionAlert[]
  integrationRunLogs             IntegrationRunLog[]
  competitors                    Competitor[]
  providers                      ProviderProfile[]
  staffProfiles                  StaffProfile[]
  reputationCases                ReputationCase[]
  reviewRequests                 ReviewRequest[]
  userClinicAccesses             UserClinicAccess[]
  appointmentRequests            AppointmentRequest[]
  devices                        Device[]
  receptionistLocations          ReceptionistLocation[]
  receptionistOutboundCampaignDefaults ReceptionistOutboundCampaign[] @relation("ReceptionistOutboundDefaultBranch")
  campaigns                      Campaign[]
