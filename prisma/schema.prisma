model ProviderProfile {
  id                    String                 @id @default(uuid()) @db.Uuid
  tenantId              String                 @db.Uuid
  branchId              String                 @db.Uuid
  userId                String                 @unique @db.Uuid
  specialty             String
  utilization           Int                    @default(0)
  appointmentsToday     Int                    @default(0)
  appointmentsThisMonth Int                    @default(0)
  rating                Decimal                @default(0) @db.Decimal(3, 2)
  reviewCount           Int                    @default(0)
  revenueThisMonth      Decimal                @default(0) @db.Decimal(14, 2)
  repeatVisitRate       Int                    @default(0)
  followUpRate          Int                    @default(0)
  // Whether this clinician is on the booking schedule. Deactivation is how a
  // clinic retires a provider without deleting the identity their existing
  // appointments, reviews and revenue rows point at: every booking path
  // (front desk, patient portal, AI receptionist) resolves through
  // resolveProviderSchedulingContext, which refuses an inactive profile.
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch                Branch                 @relation(fields: [branchId], references: [id], onDelete: Restrict)
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  availability          ProviderAvailability[]
  timeOff               ProviderTimeOff[]
  appointments          Appointment[]

  @@index([tenantId, branchId, utilization])
  @@index([tenantId, revenueThisMonth])
}

// Recurring weekly working hours for a provider (one row per open window per
// weekday). Minutes are measured from local-clinic midnight; slotMinutes is the
// granularity the slot service tiles each window into. Tenant cleanup cascades
// transitively via ProviderProfile.
model ProviderAvailability {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  branchId          String          @db.Uuid
  providerProfileId String          @db.Uuid
  dayOfWeek         Int // 0=Sunday .. 6=Saturday
  startMinute       Int // minutes from midnight, clinic-local
  endMinute         Int
  slotMinutes       Int             @default(30)
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  provider          ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@unique([providerProfileId, dayOfWeek, startMinute], map: "ProviderAvailability_providerProfileId_dayOfWeek_startMinute_ke")
  @@index([tenantId, providerProfileId, dayOfWeek])
}

// Per-tenant self-scheduling policy: whether patients may self-book, the booking
// horizon/notice, and which pre-visit requirements must be satisfied before a
// patient self-book is allowed to confirm. One row per tenant; absence = defaults
// (self-book on, no pre-visit gating) so existing behaviour is unchanged.
model SchedulingPolicy {
  id                            String   @id @default(uuid()) @db.Uuid
  tenantId                      String   @unique @db.Uuid
  selfBookEnabled               Boolean  @default(true)
  requireEligibilityForSelfBook Boolean  @default(false)
  requireIntakeForSelfBook      Boolean  @default(false)
  maxHorizonDays                Int      @default(90)
  minNoticeHours                Int      @default(0)
  // Confirmations for appointments a human books. Off by default: turning
  // messaging on for an existing tenant would send patients messages the clinic
  // never asked to send. A clinic opts in.
  confirmBookingsBySms          Boolean  @default(false)
  confirmBookingsByEmail        Boolean  @default(false)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  tenant                        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// One-off provider unavailability (vacation, blocked time). Overlapping slots are
// removed from availability for the covered range.
model ProviderTimeOff {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  providerProfileId String          @db.Uuid
  startsAt          DateTime
  endsAt            DateTime
  reason            String?
  createdAt         DateTime        @default(now())
  provider          ProviderProfile @relation(fields: [providerProfileId], references: [id], onDelete: Cascade)

  @@index([tenantId, providerProfileId, startsAt])
}

