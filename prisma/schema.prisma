  required             Boolean               @default(true)
  confirmationRequired Boolean               @default(false)
  sortOrder            Int                   @default(0)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaign             ReceptionistCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, sortOrder])
  @@index([tenantId])
}

model ReceptionistCallLog {
  id                           String                               @id @default(uuid()) @db.Uuid
  tenantId                     String                               @db.Uuid
  clinicId                     String?                              @db.Uuid
  campaignId                   String?                              @db.Uuid
  retellCallId                 String?                              @unique
  // Inbound patient-data tools bind the signed provider envelope to one exact,
  // currently verified clinic deployment before any tool is dispatched. These
  // fields are immutable call authority; null is retained for legacy and
  // outbound rows that predate or do not use inbound tool execution.
  boundProviderAgentId         String?
  boundProviderAgentVersion    Int?
  boundProviderConfigRevision  Int?
  boundProviderFingerprint     String?
  callerName                   String?
  callerPhone                  String?
  direction                    String                               @default("outbound")
  outcome                      ReceptionistCallOutcome              @default(IN_PROGRESS)
  durationSeconds              Int                                  @default(0)
  recordingUrl                 String?
  transcriptSummary            String?
  // Human-authored operational review is kept separate from provider-derived
  // call analysis. The JSON shape is server-controlled and includes explicit
  // STAFF_ENTERED attribution for each structured field.
  operationalNotes             Json?
  unresolvedActionItems        String[]                             @default([])
  reviewStatus                 ReceptionistCallReviewStatus         @default(UNREVIEWED)
  reviewRevision               Int                                  @default(0)
  reviewedByUserId             String?                              @db.Uuid
  reviewedAt                   DateTime?
  signedOffByUserId            String?                              @db.Uuid
  signedOffAt                  DateTime?
  recordingConsentStatus       ReceptionistRecordingConsentStatus   @default(UNDETERMINED)
  recordingConsentAt           DateTime?
  recordingRetentionExpiresAt  DateTime?
  transcriptRetentionExpiresAt DateTime?
  recordingPurgedAt            DateTime?
  transcriptPurgedAt           DateTime?
  vendorDeletionConfirmedAt    DateTime?
  sentiment                    String?
  startedAt                    DateTime?
  endedAt                      DateTime?
  // Stamped once from the clinic hours engine when the call is first seen;
  // null = hours were not configured at call time (never "false").
  outsideHours                 Boolean?
  // 'connected' | 'unknown' from the provider disconnection reason at call end.
  transferOutcome              String?
  localePackId                 String?                              @db.Uuid
  outboundCampaignId           String?                              @db.Uuid
  targetId                     String?                              @db.Uuid
  // Caller identity (C4): linked only from a verified identity or a single canonical phone match.
  patientId                    String?                              @db.Uuid
  createdAt                    DateTime                             @default(now())
  updatedAt                    DateTime                             @updatedAt
  tenant                       Tenant                               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clinic                       ReceptionistClinic?                  @relation(fields: [tenantId, clinicId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistCallLog_clinic_scope_fkey")
  campaign                     ReceptionistCampaign?                @relation(fields: [tenantId, campaignId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistCallLog_campaign_scope_fkey")
  outboundCampaign             ReceptionistOutboundCampaign?        @relation(fields: [tenantId, outboundCampaignId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistCallLog_outbound_campaign_scope_fkey")
  target                       ReceptionistCallTarget?               @relation("ReceptionistCallLogTarget", fields: [tenantId, outboundCampaignId, targetId], references: [tenantId, campaignId, id], onDelete: Restrict, map: "ReceptionistCallLog_target_ownership_fkey")
  lastForTargets               ReceptionistCallTarget[]              @relation("ReceptionistCallTargetLastCall")
  outboundProviderIntent       ReceptionistOutboundProviderIntent?
  recordingConsentEvents       ReceptionistRecordingConsentEvent[]
  artifactLifecycleEvents      ReceptionistArtifactLifecycleEvent[]
  legalHolds                   ReceptionistCallLegalHold[]
  reviewedBy                   User?                                @relation("ReceptionistCallReviewer", fields: [tenantId, reviewedByUserId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistCallLog_reviewer_scope_fkey")
  signedOffBy                  User?                                @relation("ReceptionistCallSignoff", fields: [tenantId, signedOffByUserId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistCallLog_signoff_scope_fkey")
  localePack                   ReceptionistLocalePack?              @relation(fields: [tenantId, localePackId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistCallLog_locale_pack_scope_fkey")
  appointmentRequests          AppointmentRequest[]               @relation("AppointmentRequestSourceCall")
  appointments                 Appointment[]                      @relation("AppointmentSourceCall")
  patient                      Patient?                             @relation("ReceptionistCallLogPatient", fields: [tenantId, patientId], references: [tenantId, id], onDelete: Restrict, map: "ReceptionistCallLog_patient_scope_fkey")
  staffTasks                   StaffTask[]                          @relation("StaffTaskSourceCall")
  appointmentNotes             AppointmentNote[]                    @relation("AppointmentNoteSourceCall")

  @@unique([tenantId, id])
  @@unique([tenantId, outboundCampaignId, id])
  @@index([tenantId, outcome, createdAt])
  @@index([outboundCampaignId])
  @@index([tenantId, recordingRetentionExpiresAt])
  @@index([tenantId, transcriptRetentionExpiresAt])
  @@index([tenantId, reviewStatus, updatedAt])
  @@index([tenantId, boundProviderAgentId, boundProviderAgentVersion])
  @@index([tenantId, patientId, createdAt])
  @@index([tenantId, clinicId, createdAt])
  @@index([tenantId, clinicId, direction, createdAt])
}

