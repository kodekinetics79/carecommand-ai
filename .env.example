NODE_ENV=development
# ── Deployment profile gate ──────────────────────────────────────────────────
# demo | pilot | enterprise. Deployment POSTURE, deliberately separate from
# NODE_ENV (the E2E harness runs NODE_ENV=production under 'demo'). Under
# 'pilot'/'enterprise', any integration still in mock mode (PAYMENT_PROVIDER/
# INSURANCE_PROVIDER/AI_PROVIDER = mock) FAILS BOOT unless explicitly
# acknowledged below; 'enterprise' never allows mock payments at all.
# Live posture is reported at GET /health/integrations.
# See docs/INTEGRATION_MODE_REGISTER.md.
DEPLOYMENT_PROFILE=demo
# Comma-separated mock acknowledgements for pilot/enterprise, e.g. "ai,insurance".
# Valid tokens: payments | insurance | ai (unknown tokens fail boot).
ALLOWED_MOCK_INTEGRATIONS=
API_HOST=0.0.0.0
API_PORT=3001
# Runtime app connection. For RLS enforcement this MUST be the restricted,
# non-superuser role `app_rls` (created by the enable_rls_pilot migration; set
# its password via prisma/rls/app_rls_setup.sql). Single-role dev setups may
# point this at the owner instead, but then RLS is bypassed (no enforcement).
DATABASE_URL=postgresql://app_rls:CHANGE_ME@localhost:55432/carecommand?schema=public
# Dedicated platform/control-plane role. Required in production and must remain
# NOSUPERUSER, NOBYPASSRLS, NOCREATEDB, NOCREATEROLE, NOINHERIT and own no tables.
PLATFORM_DATABASE_URL=postgresql://app_platform:CHANGE_ME@localhost:55432/carecommand?schema=public
# Owner/superuser connection used ONLY by migrations + seed (must bypass RLS).
# If unset, migrations/seed fall back to DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql://carecommand:carecommand@localhost:55432/carecommand?schema=public
# Secret used by prisma/rls/app_rls_setup.sql to set the app_rls password:
#   psql "$DATABASE_MIGRATION_URL" -v app_rls_password="$APP_RLS_PASSWORD" -f prisma/rls/app_rls_setup.sql
APP_RLS_PASSWORD=CHANGE_ME
# RLS runtime-role guard. The app warns (error-logs in prod) at boot if the
# runtime role can bypass RLS. Set true to FAIL CLOSED — refuse to boot when the
# role is not restricted — after DATABASE_URL is cut over to app_rls in prod.
RLS_ENFORCE_RUNTIME_ROLE=false
REDIS_URL=redis://localhost:56379
QUEUE_NAMESPACE=carecommand-local
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-too
ELIGIBILITY_HMAC_SECRET=replace-with-a-stable-dedicated-32-character-secret
ELIGIBILITY_HMAC_KEY_VERSION=v1
# Set both previous values for one-generation dual-read during rotation.
ELIGIBILITY_HMAC_PREVIOUS_SECRET=
ELIGIBILITY_HMAC_PREVIOUS_KEY_VERSION=
ELIGIBILITY_RECONCILIATION_ENABLED=true
ELIGIBILITY_RECONCILIATION_INTERVAL_SECONDS=60
ELIGIBILITY_RECONCILIATION_STALE_SECONDS=300
ELIGIBILITY_RECONCILIATION_BATCH_SIZE=25
ELIGIBILITY_RECONCILIATION_MAX_CONCURRENCY=2

# ---- Outbound dialler ------------------------------------------------------
# Works through a RUNNING campaign's PENDING targets without anyone clicking
# Call. OFF by default: the failure mode of leaving it off is that a clinic
# keeps dialling by hand, and the failure mode of turning it on by accident is
# a phone ringing in a patient's house. Needs an always-on worker process
# (QUEUES_ENABLED=true), and each campaign's own `dialerEnabled` switch too.
RECEPTIONIST_OUTBOUND_DIAL_ENABLED=false
RECEPTIONIST_OUTBOUND_DIAL_INTERVAL_SECONDS=60
RECEPTIONIST_OUTBOUND_DIAL_MAX_CONCURRENCY=4
RECEPTIONIST_OUTBOUND_DIAL_MAX_PER_PASS=25
ELIGIBILITY_SUCCESS_REPLAY_SECONDS=900
# Auth hardening (Phase A). AUTH_ENCRYPTION_KEY encrypts MFA secrets at rest;
# if unset, a key is derived from JWT_SECRET (set a dedicated key in production).
AUTH_ENCRYPTION_KEY=
PASSWORD_MIN_LENGTH=8
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60
MFA_ISSUER=CareCommand AI
# ── Observability ────────────────────────────────────────────────────────────
# Durable error capture. Set SENTRY_DSN AND `npm i @sentry/node` to activate;
# registerSentry() wires it at boot. Unset → structured error logs only.
# SERVICE_ENV/RELEASE tag captured events (and traces/metrics) for triage.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SERVICE_ENV=
RELEASE=
# Logical service name on traces/metrics/logs. Leave unset: the API defaults to
# carecommand-api and the worker to carecommand-worker (workers/otelDefaults.ts).
# Setting it here would force BOTH processes to report the same name.
# OTEL_SERVICE_NAME=
# Distributed tracing (OpenTelemetry). Off by default = zero overhead. Turn on
# and point at an OTLP/HTTP endpoint (collector or vendor: Tempo, Honeycomb,
# Axiom, …). Headers are "key=value,key2=value2" (e.g. an ingest API key).
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER_RATIO=1
# Prometheus metrics at /metrics. In PRODUCTION the route is protected: set
# METRICS_TOKEN and scrapers send `Authorization: Bearer <token>`. Unset in prod
# → /metrics returns 404 (never leaks internal cardinality). Dev needs neither.
METRICS_ENABLED=true
METRICS_TOKEN=
# The worker process serves its own /metrics (job outcomes live there) on this
# port — scrape both the API and the worker. Same METRICS_TOKEN rule applies.
WORKER_METRICS_PORT=9464
# LEGACY/DEV-ONLY platform operator token (separate from tenant roles). The
# production path is the Platform Admin Console (PlatformUser accounts below).
# A dev default is used when unset in non-production; do not expose in the UI.
PLATFORM_API_TOKEN=
PLATFORM_LEGACY_TOKEN_ENABLED=false
# Platform Admin Console: the first PLATFORM_OWNER is seeded ONLY from these
# vars (no weak default in production). Set all three to seed on `npm run db:seed`.
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_NAME=
PLATFORM_OWNER_PASSWORD=
TRIAL_DAYS=14
VITE_AUTH_MODE=login-required
VITE_DEFAULT_CLINIC_SLUG=harley-street-medical
CORS_ORIGINS=http://localhost:12000
# Trust only the private/load-balancer proxy hops that exclusively front the
# origin. Empty is safest for directly reachable/local API processes. Forwarded
# client IP headers are ignored unless the immediate peer matches this list.
INGRESS_MODE=direct
TRUSTED_PROXY_CIDRS=
# Auth cookie SameSite. 'lax' for same-origin; set 'none' when the frontend and
# API are on different sites (e.g. Vercel UI + Render API) so refresh/CSRF
# cookies are sent cross-site. 'none' forces Secure (HTTPS).
COOKIE_SAMESITE=lax
LOG_LEVEL=info
# ── AI Model Gateway ────────────────────────────────────────────────────────
# Provider-agnostic gateway. Keys are read ONLY here on the backend; they are
# never sent to the frontend and never logged. Default `mock` works with no
# model server (deterministic, evidence-backed).
AI_PROVIDER=mock                       # mock | ollama | openai | claude
# Ollama: local talks to OLLAMA_BASE_URL/api; cloud talks to https://ollama.com/api
# with OLLAMA_API_KEY as a Bearer token.
OLLAMA_MODE=local                      # local | cloud
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=                        # required only for OLLAMA_MODE=cloud
OLLAMA_MODEL=llama3.1
OLLAMA_DEFAULT_MODEL=llama3.1          # e.g. gpt-oss:20b on Ollama cloud
# Governance: keep PHI out of AI by default, cap daily spend, gate sensitive actions.
AI_ENABLE_PHI=false
AI_COST_BUDGET_DAILY_USD=5
AI_REQUIRE_HUMAN_APPROVAL=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-3-5-sonnet-20241022
# ── Insurance eligibility ───────────────────────────────────────────────────
# Stedi SANDBOX needs NO key (deterministic simulator). STEDI_API_KEY is only
# required to flip Stedi to production (live 270/271). Optum/Availity stay
# NOT_CONFIGURED until real credentials are entered in Integration Setup.
INSURANCE_PROVIDER=mock
STEDI_API_KEY=
STEDI_BASE_URL=https://healthcare.us.stedi.com
STEDI_TEST_MODE=true
# NOTE: Connected-care device providers (Dexcom, Withings, Validic, Terra,
# Tenovi, manual) and insurance providers are configured PER TENANT in-app at
# Integration Setup (/integration-setup) — their credentials are encrypted in
# the DB, not read from env. See docs/CONNECTED_CARE_SANDBOX.md.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/revenue-protection?payment=success
STRIPE_CANCEL_URL=http://localhost:5173/revenue-protection?payment=cancel
SQUARE_ACCESS_TOKEN=
AUTHORIZE_NET_API_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
# Twilio powers real SMS/WhatsApp campaign sends (raw HTTP, no SDK). A SID
# starting with "mock" enables a dev-only mock send (never in production).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_BASE_URL=https://api.twilio.com
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# Optional HTTP email API (e.g. SendGrid) so campaign email can really send
# without an SMTP TCP library. If unset, email stays configured_pending_provider.
EMAIL_HTTP_API_URL=
EMAIL_HTTP_API_KEY=
EMAIL_FROM_ADDRESS=
# HMAC signing secret for the campaign delivery/status webhook (provider callback
# at POST /v1/crm/webhooks/delivery). Unset → webhook returns provider_not_integrated.
CAMPAIGN_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
# Optional local-only dev-token identity. Leave unset unless the target rows
# were explicitly provisioned in this environment.
# DEV_TENANT_ID=00000000-0000-4000-8000-000000000000
# DEV_USER_ID=00000000-0000-4000-8000-000000000000
# AI Receptionist Studio (RetellAI voice agent). PUBLIC_API_URL is the
# externally reachable base used to build the Retell webhook URL.
PUBLIC_API_URL=http://localhost:3001
# Retell credentials for outbound calling. The API key and originating number
# are required; immutable agent ID/version bindings are verified and stored per
# tenant/clinic in Receptionist Studio. If either environment value is unset,
# the API returns setup_required instead of dialing. A
# key starting with "mock" enables a local mock dialer (no network, no real
# calls) for development and the verification script. Never commit real keys.
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_BASE_URL=https://api.retellai.com
VITE_API_URL=http://localhost:3001
VITE_DEMO_FALLBACK=false

# ── Attended synthetic live voice UAT ──────────────────────────────────────
# OFF by default. Configure only in the local process environment for a single
# attended run. Exactly one E.164 recipient is allowed. Authorization expires
# within 24 hours and all call/minute/cost caps are validated at boot. Never
# commit a real recipient or Retell secret.
LIVE_TEST_CALLS_AUTHORIZED=false
LIVE_TEST_EXECUTION_ID=
LIVE_TEST_TENANT_ID=
AUTHORIZED_TEST_PHONE_E164=
LIVE_TEST_RECIPIENT_ALLOWLIST=
LIVE_TEST_EXPIRES_AT=
LIVE_TEST_TIMEZONE=America/New_York
LIVE_TEST_WINDOW_START=09:00
LIVE_TEST_WINDOW_END=20:00
LIVE_TEST_MAX_CALLS=0
LIVE_TEST_MAX_CALL_MINUTES=5
LIVE_TEST_MAX_TOTAL_MINUTES=0
LIVE_TEST_MAX_PROVIDER_COST_USD=0
LIVE_TEST_ESTIMATED_COST_PER_MINUTE_USD=0

# Set these only when final browser evidence must launch the user's installed
# Google Chrome rather than Playwright's bundled Chromium.
E2E_USE_INSTALLED_CHROME=false
E2E_HEADLESS=true
# Playwright-only references for the attended Retell live-call UAT. These are
# not application secrets and are not parsed by the API server; set them only
# in the local test process to bind the disposable synthetic agent fixture to
# the exact published Retell deployment under test.
LIVE_TEST_RETELL_AGENT_ID=
LIVE_TEST_RETELL_AGENT_VERSION=
RUN_LIVE_VOICE_UAT=false
