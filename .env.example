NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
# Runtime app connection. For RLS enforcement this MUST be the restricted,
# non-superuser role `app_rls` (created by the enable_rls_pilot migration; set
# its password via prisma/rls/app_rls_setup.sql). Single-role dev setups may
# point this at the owner instead, but then RLS is bypassed (no enforcement).
DATABASE_URL=postgresql://app_rls:CHANGE_ME@localhost:55432/carecommand?schema=public
# Owner/superuser connection used ONLY by migrations + seed (must bypass RLS).
# If unset, migrations/seed fall back to DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql://carecommand:carecommand@localhost:55432/carecommand?schema=public
# Secret used by prisma/rls/app_rls_setup.sql to set the app_rls password:
#   psql "$DATABASE_MIGRATION_URL" -v app_rls_password="$APP_RLS_PASSWORD" -f prisma/rls/app_rls_setup.sql
APP_RLS_PASSWORD=CHANGE_ME
# RLS runtime-role guard. The app warns (error-logs in prod) at boot if the
# runtime role can bypass RLS. Set true to FAIL CLOSED — refuse to boot when the
# role is not restricted — after DATABASE_URL is cut over to app_rls in prod.
RLS_ENFORCE_RUNTIME_ROLE=false
REDIS_URL=redis://localhost:56379
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-too
# Auth hardening (Phase A). AUTH_ENCRYPTION_KEY encrypts MFA secrets at rest;
# if unset, a key is derived from JWT_SECRET (set a dedicated key in production).
AUTH_ENCRYPTION_KEY=
PASSWORD_MIN_LENGTH=8
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_DURATION_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=60
MFA_ISSUER=CareCommand AI
# Observability. Set SENTRY_DSN to enable error reporting (wire the reporter at
# boot via setErrorReporter in server/lib/observability.ts). Unset → structured
# error logs only. SERVICE_ENV/RELEASE tag captured events for triage.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SERVICE_ENV=
RELEASE=
# LEGACY/DEV-ONLY platform operator token (separate from tenant roles). The
# production path is the Platform Admin Console (PlatformUser accounts below).
# A dev default is used when unset in non-production; do not expose in the UI.
PLATFORM_API_TOKEN=
# Platform Admin Console: the first PLATFORM_OWNER is seeded ONLY from these
# vars (no weak default in production). Set all three to seed on `npm run db:seed`.
PLATFORM_OWNER_EMAIL=
PLATFORM_OWNER_NAME=
PLATFORM_OWNER_PASSWORD=
TRIAL_DAYS=14
VITE_AUTH_MODE=login-required
CORS_ORIGINS=http://localhost:12000
# Auth cookie SameSite. 'lax' for same-origin; set 'none' when the frontend and
# API are on different sites (e.g. Vercel UI + Render API) so refresh/CSRF
# cookies are sent cross-site. 'none' forces Secure (HTTPS).
COOKIE_SAMESITE=lax
LOG_LEVEL=info
# ── AI Model Gateway ────────────────────────────────────────────────────────
# Provider-agnostic gateway. Keys are read ONLY here on the backend; they are
# never sent to the frontend and never logged. Default `mock` works with no
# model server (deterministic, evidence-backed).
AI_PROVIDER=mock                       # mock | ollama | openai | claude
# Ollama: local talks to OLLAMA_BASE_URL/api; cloud talks to https://ollama.com/api
# with OLLAMA_API_KEY as a Bearer token.
OLLAMA_MODE=local                      # local | cloud
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=                        # required only for OLLAMA_MODE=cloud
OLLAMA_MODEL=llama3.1
OLLAMA_DEFAULT_MODEL=llama3.1          # e.g. gpt-oss:20b on Ollama cloud
# Governance: keep PHI out of AI by default, cap daily spend, gate sensitive actions.
AI_ENABLE_PHI=false
AI_COST_BUDGET_DAILY_USD=5
AI_REQUIRE_HUMAN_APPROVAL=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
CLAUDE_API_KEY=
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-3-5-sonnet-20241022
# ── Insurance eligibility ───────────────────────────────────────────────────
# Stedi SANDBOX needs NO key (deterministic simulator). STEDI_API_KEY is only
# required to flip Stedi to production (live 270/271). Optum/Availity stay
# NOT_CONFIGURED until real credentials are entered in Integration Setup.
INSURANCE_PROVIDER=mock
STEDI_API_KEY=
STEDI_BASE_URL=https://healthcare.us.stedi.com
STEDI_TEST_MODE=true
# NOTE: Connected-care device providers (Dexcom, Withings, Validic, Terra,
# Tenovi, manual) and insurance providers are configured PER TENANT in-app at
# Integration Setup (/integration-setup) — their credentials are encrypted in
# the DB, not read from env. See docs/CONNECTED_CARE_SANDBOX.md.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:5173/revenue-protection?payment=success
STRIPE_CANCEL_URL=http://localhost:5173/revenue-protection?payment=cancel
SQUARE_ACCESS_TOKEN=
AUTHORIZE_NET_API_LOGIN_ID=
AUTHORIZE_NET_TRANSACTION_KEY=
# Twilio powers real SMS/WhatsApp campaign sends (raw HTTP, no SDK). A SID
# starting with "mock" enables a dev-only mock send (never in production).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_BASE_URL=https://api.twilio.com
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
# Optional HTTP email API (e.g. SendGrid) so campaign email can really send
# without an SMTP TCP library. If unset, email stays configured_pending_provider.
EMAIL_HTTP_API_URL=
EMAIL_HTTP_API_KEY=
EMAIL_FROM_ADDRESS=
# HMAC signing secret for the campaign delivery/status webhook (provider callback
# at POST /v1/crm/webhooks/delivery). Unset → webhook returns provider_not_integrated.
CAMPAIGN_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
DEV_TENANT_ID=11111111-1111-4111-8111-111111111111
DEV_USER_ID=22222222-2222-4222-8222-222222222222
# AI Receptionist Studio (RetellAI voice agent). PUBLIC_API_URL is the
# externally reachable base used to build the Retell webhook URL.
PUBLIC_API_URL=http://localhost:3001
# Retell credentials for outbound calling. All three are required to place real
# calls; if any is unset the API returns setup_required instead of dialing. A
# key starting with "mock" enables a local mock dialer (no network, no real
# calls) for development and the verification script. Never commit real keys.
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=
RETELL_BASE_URL=https://api.retellai.com
VITE_API_URL=http://localhost:3001
VITE_DEMO_FALLBACK=false
